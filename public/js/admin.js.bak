function escapeHtml(str) {
  if (!str) return '';
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// 管理员控制台应用
class AdminApp {
  constructor() {
    this.user = null;
    this.stats = null;
    this.currentPage = 'adminDashboard';
    this.selectedModels = new Set();
    this.selectedCodes = new Set();
    this.modelsData = [];
    this.filteredModels = [];
    this.init();
  }

  async init() {
    await this.loadUserInfo();
    this.bindEvents();
    // 预加载代理配置以显示侧边栏项
    this.loadDs2apiConfig();
    this.loadQwen2apiConfig();
    this.loadZai2apiConfig();
    this.loadPage(this.currentPage);
  }

  async loadUserInfo() {
    try {
      const response = await fetch('/auth/me');
      if (response.ok) {
        this.user = await response.json();
        if (!this.user.isAdmin) {
          window.location.href = '/console';
          return;
        }
        this.updateUserInfo();
      } else {
        window.location.href = '/';
      }
    } catch (error) {
      console.error('加载用户信息失败:', error);
      window.location.href = '/';
    }
  }

  updateUserInfo() {
    const usernameEl = document.getElementById('username');
    const avatarEl = document.getElementById('userAvatar');
    
    if (usernameEl) usernameEl.textContent = this.user.username;
    if (avatarEl) {
      avatarEl.src = this.user.avatar || '';
      avatarEl.onerror = () => {
        avatarEl.src = `data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><rect fill="%233b82f6" width="32" height="32" rx="16"/><text x="50%" y="50%" font-size="14" fill="white" text-anchor="middle" dy=".3em">${this.user.username.charAt(0).toUpperCase()}</text></svg>`;
      };
    }
  }

  bindEvents() {
    // 导航点击
    const navItems = document.querySelectorAll('.nav-item[data-page]');
    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const page = item.dataset.page;
        this.navigateTo(page);
      });
    });

    // 登出按钮
    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => this.logout());
    }

    // 添加模型按钮
    const addModelBtn = document.getElementById('addModelBtn');
    if (addModelBtn) {
      addModelBtn.addEventListener('click', () => this.showAddModelModal());
    }

    // 批量操作按钮
    const batchDeleteBtn = document.getElementById('batchDeleteModelsBtn');
    if (batchDeleteBtn) {
      batchDeleteBtn.addEventListener('click', () => this.batchDeleteModels());
    }
    const batchEnableBtn = document.getElementById('batchEnableModelsBtn');
    if (batchEnableBtn) {
      batchEnableBtn.addEventListener('click', () => this.batchUpdateModels(true));
    }
    const batchDisableBtn = document.getElementById('batchDisableModelsBtn');
    if (batchDisableBtn) {
      batchDisableBtn.addEventListener('click', () => this.batchUpdateModels(false));
    }
    const batchSetPricesBtn = document.getElementById('batchSetPricesBtn');
    if (batchSetPricesBtn) {
      batchSetPricesBtn.addEventListener('click', () => this.showBatchSetPricesModal());
    }
    const batchAdjustPricesBtn = document.getElementById('batchAdjustPricesBtn');
    if (batchAdjustPricesBtn) {
      batchAdjustPricesBtn.addEventListener('click', () => this.showBatchAdjustPricesModal());
    }
    const batchSetRateLimitBtn = document.getElementById('batchSetRateLimitBtn');
    if (batchSetRateLimitBtn) {
      batchSetRateLimitBtn.addEventListener('click', () => this.showBatchSetRateLimitModal());
    }

    // 保存用户按钮
    const saveUserBtn = document.getElementById('saveUserBtn');
    if (saveUserBtn) {
      saveUserBtn.addEventListener('click', () => this.saveUser());
    }

    // 保存模型按钮
    const saveModelBtn = document.getElementById('saveModelBtn');
    if (saveModelBtn) {
      saveModelBtn.addEventListener('click', () => this.saveModel());
    }

    // 添加供应商按钮 - 下拉菜单
    const addProviderBtn = document.getElementById('addProviderBtn');
    const addProviderMenu = document.getElementById('addProviderMenu');
    if (addProviderBtn && addProviderMenu) {
      addProviderBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        addProviderMenu.classList.toggle('active');
      });
    }

    // OpenAI 账号登录
    const addOpenaiLoginBtn = document.getElementById('addOpenaiLoginBtn');
    if (addOpenaiLoginBtn) {
      addOpenaiLoginBtn.addEventListener('click', () => {
        addProviderMenu.classList.remove('active');
        this.openaiOAuthLogin();
      });
    }

    // DeepSeek 账号登录
    const addDeepseekLoginBtn = document.getElementById('addDeepseekLoginBtn');
    if (addDeepseekLoginBtn) {
      addDeepseekLoginBtn.addEventListener('click', () => {
        addProviderMenu.classList.remove('active');
        this.openDeepseekLogin();
      });
    }

    // 添加自定义供应商
    const addCustomProviderBtn = document.getElementById('addCustomProviderBtn');
    if (addCustomProviderBtn) {
      addCustomProviderBtn.addEventListener('click', () => {
        addProviderMenu.classList.remove('active');
        this.showAddProviderModal();
      });
    }

    // 点击外部关闭下拉菜单
    document.addEventListener('click', () => {
      if (addProviderMenu) addProviderMenu.classList.remove('active');
    });

    // 查询供应商信息按钮
    const lookupProviderBtn = document.getElementById('lookupProviderBtn');
    if (lookupProviderBtn) {
      lookupProviderBtn.addEventListener('click', () => this.lookupProviderInfo());
    }

    // 保存供应商按钮
    const saveProviderBtn = document.getElementById('saveProviderBtn');
    if (saveProviderBtn) {
      saveProviderBtn.addEventListener('click', () => this.saveProvider());
    }

    // 导入 OpenCode 配置按钮
    const importOpenCodeBtn = document.getElementById('importOpenCodeBtn');
    if (importOpenCodeBtn) {
      importOpenCodeBtn.addEventListener('click', () => this.showImportOpenCodeModal());
    }

    // 确认导入按钮
    const confirmImportBtn = document.getElementById('confirmImportOpenCodeBtn');
    if (confirmImportBtn) {
      confirmImportBtn.addEventListener('click', () => this.importOpenCodeConfig());
    }

    // 文件上传监听
    const configFile = document.getElementById('openCodeConfigFile');
    if (configFile) {
      configFile.addEventListener('change', (e) => this.handleConfigFileUpload(e));
    }

    // 配置文本框输入预览
    const configText = document.getElementById('openCodeConfigText');
    if (configText) {
      configText.addEventListener('input', (e) => {
        const content = e.target.value.trim();
        if (content) {
          this.previewConfig(content);
        } else {
          document.getElementById('importPreview').style.display = 'none';
        }
      });
    }

    // 管理员设置表单
    const adminSettingsForm = document.getElementById('adminSettingsForm');
    if (adminSettingsForm) {
      adminSettingsForm.addEventListener('submit', (e) => this.saveAdminSettings(e));
    }

    // 模态框关闭按钮
    const modalCloseButtons = document.querySelectorAll('.modal-close');
    modalCloseButtons.forEach(btn => {
      btn.addEventListener('click', () => this.closeModals());
    });

    // 可退款复选框切换手续费率显示
    const codeRefundable = document.getElementById('codeRefundable');
    if (codeRefundable) {
      codeRefundable.addEventListener('change', () => {
        document.getElementById('codeFeeRateGroup').style.display = codeRefundable.checked ? 'block' : 'none';
      });
    }
    const editCodeRefundable = document.getElementById('editCodeRefundable');
    if (editCodeRefundable) {
      editCodeRefundable.addEventListener('change', () => {
        document.getElementById('editCodeFeeRateGroup').style.display = editCodeRefundable.checked ? 'block' : 'none';
      });
    }
    const batchSetRefundable = document.getElementById('batchSetRefundable');
    if (batchSetRefundable) {
      batchSetRefundable.addEventListener('change', () => {
        document.getElementById('batchSetFeeRateGroup').style.display = batchSetRefundable.checked ? 'block' : 'none';
      });
    }
  }

  navigateTo(page) {
    // 更新导航状态
    document.querySelectorAll('.nav-item').forEach(item => {
      item.classList.remove('active');
    });
    document.querySelector(`.nav-item[data-page="${page}"]`)?.classList.add('active');

    // 更新页面显示
    document.querySelectorAll('.page').forEach(p => {
      p.classList.remove('active');
    });
    document.getElementById(`${page}Page`)?.classList.add('active');

    // 更新页面标题
    const titles = {
      'adminDashboard': '仪表盘',
      'adminUsers': '用户管理',
      'adminTeams': 'Team 管理',
      'adminModels': '模型管理',
      'adminProviders': '供应商管理',
      'adminDs2api': 'DS2API 配置',
      'adminQwen2api': 'Qwen2API 配置',
      'adminZai2api': 'Z.ai2API 配置',
      'adminKimi2api': 'Kimi2API 管理',
      'adminStats': '用量监控',
      'adminSettings': '系统设置',
      'adminRedemptionCodes': '兑换码管理',
      'adminProducts': '商品管理'
    };
    document.getElementById('pageTitle').textContent = titles[page] || page;

    this.currentPage = page;
    this.loadPage(page);
  }

  async loadPage(page) {
    switch (page) {
      case 'adminDashboard':
        await this.loadDashboard();
        break;
      case 'adminUsers':
        await this.loadUsers();
        break;
      case 'adminTeams':
        await this.loadTeams();
        break;
      case 'adminModels':
        await this.loadModels();
        break;
      case 'adminProviders':
        await this.loadKimi2apiConfig();
        await this.loadCodexStatus();
        await this.loadProviders();
        await this.loadDeepseekAccounts();
        await this.loadDs2apiKeys();
        break;
      case 'adminDs2api':
        await this.loadDs2apiConfig();
        break;
      case 'adminQwen2api':
        await this.loadQwen2apiConfig();
        break;
      case 'adminZai2api':
        await this.loadZai2apiConfig();
        await this.loadZai2apiAccounts();
        break;
      case 'adminKimi2api':
        await this.loadKimi2apiPage();
        break;
      case 'adminStats':
        await this.loadStats();
        this.loadUsageLogs(1);
        break;
      case 'adminSettings':
        await this.loadSettings();
        break;
      case 'adminRedemptionCodes':
        await this.loadRedemptionCodes();
        break;
      case 'adminProducts':
        await this.loadProducts();
        break;
    }
  }

  async loadDashboard() {
    try {
      const response = await fetch('/api/admin/stats');
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '加载失败');
      }
      this.stats = await response.json();
      
      document.getElementById('totalUsers').textContent = this.stats.users;
      document.getElementById('totalModels').textContent = this.stats.models;
      document.getElementById('totalApiKeys').textContent = this.stats.apiKeys;
      
      // 计算今日请求量
      const today = new Date().toISOString().split('T')[0];
      const todayStats = this.stats.daily.find(u => u.date === today);
      document.getElementById('todayRequests').textContent = todayStats ? todayStats.requests : 0;

      // 加载最近活动
      this.loadRecentActivity();
    } catch (error) {
      console.error('加载仪表盘数据失败:', error);
      document.getElementById('recentActivity').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">${error.message || '加载仪表盘数据失败'}</p>`;
    }
  }

  loadRecentActivity() {
    const container = document.getElementById('recentActivity');
    if (!this.stats || !this.stats.daily || this.stats.daily.length === 0) {
      container.innerHTML = '<p style="text-align: center; color: var(--muted-foreground); padding: 20px;">暂无活动记录</p>';
      return;
    }

    const activities = this.stats.daily.slice(0, 5).map(usage => `
      <div class="activity-item">
        <div class="activity-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <div class="activity-content">
          <div class="activity-title">${usage.requests} 次API调用</div>
          <div class="activity-time">${new Date(usage.date).toLocaleDateString('zh-CN')} · ${usage.tokens} Token</div>
        </div>
      </div>
    `).join('');

    container.innerHTML = activities;
  }

  async loadUsers() {
    try {
      const response = await fetch('/api/admin/users');
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '加载失败');
      }
      const users = await response.json();
      
      const container = document.getElementById('usersList');
      container.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>用户名</th>
              <th>邮箱</th>
              <th>验证状态</th>
              <th>余额</th>
              <th>可退款余额</th>
              <th>角色</th>
              <th>速率限制</th>
              <th>注册时间</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${users.map(user => `
              <tr>
                <td>${user.username}</td>
                <td>${user.email || '-'}</td>
                <td>${user.email_verified ? '<span style="color:#16a34a;">✓ 已验证</span>' : '<span style="color:#ef4444;">✗ 未验证</span>'}</td>
                <td>¥${parseFloat(user.balance || 0).toFixed(2)}</td>
                <td>¥${parseFloat(user.refund_balance || 0).toFixed(2)}</td>
                <td>${user.is_admin ? '<span class="badge">管理员</span>' : '普通用户'}</td>
                <td>${this.formatRateLimit(user.rate_limit_rpm, user.rate_limit_tpm)}</td>
                <td>${new Date(user.created_at).toLocaleDateString('zh-CN')}</td>
                <td>
                  <button class="btn btn-icon" title="编辑" onclick="adminApp.editUser(${JSON.stringify(user).replace(/"/g, '&quot;')})">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                  </button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (error) {
      console.error('加载用户列表失败:', error);
      document.getElementById('usersList').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">${error.message || '加载用户列表失败'}</p>`;
    }
  }

  editUser(user) {
    document.getElementById('editUserId').value = user.id;
    document.getElementById('editUserEmail').value = user.email || '';
    document.getElementById('editUserEmailVerified').value = user.email_verified ? 'true' : 'false';
    document.getElementById('editUserAdmin').value = user.is_admin.toString();
    document.getElementById('editUserBalance').value = user.balance || 0;
    document.getElementById('editUserTags').value = (user.tags || []).join(', ');
    document.getElementById('editUserRateLimitRpm').value = user.rate_limit_rpm || 0;
    document.getElementById('editUserRateLimitTpm').value = user.rate_limit_tpm || 0;
    document.getElementById('editUserRefundAmount').value = '';
    document.getElementById('refundPreview').textContent = '';
    
    this.loadUserCodeBalances(user.id);
    
    document.getElementById('editUserModal').style.display = 'flex';
    document.getElementById('editUserModal').classList.add('active');
  }

  async loadUserCodeBalances(userId) {
    const container = document.getElementById('editUserCodeBalances');
    try {
      const response = await fetch(`/api/admin/users/${userId}/code-balances`);
      if (!response.ok) throw new Error('加载失败');
      const balances = await response.json();
      
      if (balances.length === 0) {
        container.innerHTML = '<span style="color:var(--muted-foreground)">无可退款余额</span>';
        return;
      }
      
      container.innerHTML = balances.map(b => {
        const feePercent = (parseFloat(b.fee_rate) * 100).toFixed(0);
        const feeLabel = parseFloat(b.fee_rate) > 0 ? ` (费率${feePercent}%)` : '';
        const netAmount = parseFloat(b.net_amount || 0).toFixed(2);
        return `<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);">
          <span><code style="font-size:11px;">${b.code}</code>${feeLabel}</span>
          <span style="font-weight:600;">¥${netAmount}</span>
        </div>`;
      }).join('');
    } catch (error) {
      container.innerHTML = '<span style="color:var(--destructive)">加载失败</span>';
    }
  }

  async refundUser() {
    const userId = document.getElementById('editUserId').value;
    const refundAmount = parseFloat(document.getElementById('editUserRefundAmount').value);
    
    if (isNaN(refundAmount) || refundAmount <= 0) {
      alert('请输入有效的退款金额');
      return;
    }
    
    if (!confirm(`确认为该用户退款 ¥${refundAmount.toFixed(2)}？系统将按手续费从高到低扣除。`)) {
      return;
    }
    
    try {
      const response = await fetch(`/api/admin/users/${userId}/refund`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refundAmount })
      });
      
      const result = await response.json();
      
      if (response.ok && result.success) {
        alert(`退款成功！实际扣除 ¥${result.deductions.reduce((s, d) => s + d.deducted, 0).toFixed(2)}，新可退款余额 ¥${result.newRefundBalance.toFixed(2)}`);
        document.getElementById('editUserRefundAmount').value = '';
        document.getElementById('refundPreview').textContent = '';
        this.loadUserCodeBalances(userId);
        this.loadUsers();
      } else {
        alert(result.error || '退款失败');
      }
    } catch (error) {
      console.error('退款失败:', error);
      alert('退款失败');
    }
  }

  async saveUser() {
    const userId = document.getElementById('editUserId').value;
    const email = document.getElementById('editUserEmail').value.trim();
    const email_verified = document.getElementById('editUserEmailVerified').value === 'true';
    const isAdmin = document.getElementById('editUserAdmin').value === 'true';
    const balance = parseFloat(document.getElementById('editUserBalance').value);
    const tagsStr = document.getElementById('editUserTags').value;
    const tags = tagsStr ? tagsStr.split(',').map(t => t.trim()) : [];
    const rate_limit_rpm = parseInt(document.getElementById('editUserRateLimitRpm').value) || 0;
    const rate_limit_tpm = parseInt(document.getElementById('editUserRateLimitTpm').value) || 0;

    try {
      const response = await fetch(`/api/admin/users/${userId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, email_verified, isAdmin, balance, tags, rate_limit_rpm, rate_limit_tpm })
      });

      if (response.ok) {
        this.closeModals();
        this.loadUsers();
      } else {
        alert('保存失败');
      }
    } catch (error) {
      console.error('保存用户失败:', error);
      alert('保存失败');
    }
  }

  async loadModels() {
    try {
      const response = await fetch('/api/admin/models');
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '加载失败');
      }
      const models = await response.json();
      this.modelsData = models;
      this.selectedModels.clear();
      this.updateBatchButtons();
      
      // 更新供应商筛选器选项
      this.updateProviderFilter(models);
      
      // 应用筛选
      this.filterModels();
    } catch (error) {
      console.error('加载模型列表失败:', error);
      document.getElementById('adminModelsList').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">${error.message || '加载模型列表失败'}</p>`;
    }
  }

  updateProviderFilter(models) {
    const select = document.getElementById('modelProviderFilter');
    if (!select) return;
    
    const providers = [...new Set(models.map(m => m.provider))].sort();
    const currentValue = select.value;
    
    select.innerHTML = '<option value="">所有供应商</option>';
    providers.forEach(p => {
      const option = document.createElement('option');
      option.value = p;
      option.textContent = p;
      select.appendChild(option);
    });
    
    select.value = currentValue;
  }

  filterModels() {
    const search = (document.getElementById('modelSearchInput')?.value || '').toLowerCase();
    const provider = document.getElementById('modelProviderFilter')?.value || '';
    const status = document.getElementById('modelStatusFilter')?.value || '';
    
    this.filteredModels = this.modelsData.filter(model => {
      // 搜索筛选
      if (search && !model.id.toLowerCase().includes(search) && !model.name.toLowerCase().includes(search)) {
        return false;
      }
      // 供应商筛选
      if (provider && model.provider !== provider) {
        return false;
      }
      // 状态筛选
      if (status === 'enabled' && !model.enabled) return false;
      if (status === 'disabled' && model.enabled) return false;
      
      return true;
    });
    
    this.renderModels(this.filteredModels);
  }

  clearModelFilters() {
    document.getElementById('modelSearchInput').value = '';
    document.getElementById('modelProviderFilter').value = '';
    document.getElementById('modelStatusFilter').value = '';
    this.filterModels();
  }

  renderModels(models) {
    const container = document.getElementById('adminModelsList');
    const countEl = document.getElementById('modelCount');
    
    if (countEl) {
      countEl.textContent = `显示 ${models.length} / ${this.modelsData.length} 个模型`;
    }
    
    container.innerHTML = `
      <table>
        <thead>
          <tr>
            <th style="width:40px;"><input type="checkbox" class="checkbox" id="selectAllModels" onchange="adminApp.toggleSelectAll(this.checked)"></th>
            <th>模型ID</th>
            <th>别名</th>
            <th>系列</th>
            <th>说明</th>
            <th>输入价/百万Token</th>
            <th>输出价/百万Token</th>
            <th>参考输入价</th>
            <th>参考输出价</th>
            <th>思考模型</th>
            <th>非思考模型</th>
            <th>速率限制</th>
            <th>状态</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          ${models.map(model => `
            <tr>
              <td><input type="checkbox" class="checkbox" value="${model.id}" onchange="adminApp.toggleModelSelection('${model.id}', this.checked)"></td>
              <td>${model.id}</td>
              <td>${model.alias || '-'}</td>
              <td>${model.series || '-'}</td>
              <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${(model.description || '').replace(/"/g, '&quot;')}">${model.description || '-'}</td>
              <td>¥${parseFloat(model.input_price_per_1k_tokens || 0).toFixed(6)}</td>
              <td>¥${parseFloat(model.output_price_per_1k_tokens || 0).toFixed(6)}</td>
              <td>${parseFloat(model.reference_input_price_per_1k_tokens || 0) > 0 ? '¥' + parseFloat(model.reference_input_price_per_1k_tokens).toFixed(6) : '-'}</td>
              <td>${parseFloat(model.reference_output_price_per_1k_tokens || 0) > 0 ? '¥' + parseFloat(model.reference_output_price_per_1k_tokens).toFixed(6) : '-'}</td>
              <td style="font-size:12px;color:var(--muted-foreground);">${model.thinking_model_id || '-'}</td>
              <td style="font-size:12px;color:var(--muted-foreground);">${model.non_thinking_model_id || '-'}</td>
              <td>${this.formatRateLimit(model.rate_limit_rpm, model.rate_limit_tpm)}</td>
              <td>${model.enabled ? '<span style="color: #10b981">启用</span>' : '<span style="color: var(--destructive)">禁用</span>'}</td>
              <td>
                <button class="btn btn-icon" title="编辑" onclick="adminApp.editModel(${JSON.stringify(model).replace(/"/g, '&quot;')})">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                </button>
                <button class="btn btn-icon" title="删除" onclick="adminApp.deleteModel('${model.id}')">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  </svg>
                </button>
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  formatRateLimit(rpm, tpm) {
    rpm = parseInt(rpm) || 0;
    tpm = parseInt(tpm) || 0;
    if (rpm === 0 && tpm === 0) return '<span style="color:var(--muted-foreground)">不限制</span>';
    const parts = [];
    if (rpm > 0) parts.push(`${rpm} RPM`);
    if (tpm > 0) parts.push(`${tpm.toLocaleString()} TPM`);
    return parts.join('<br>');
  }

  toggleSelectAll(checked) {
    const checkboxes = document.querySelectorAll('#adminModelsList tbody input[type="checkbox"]');
    checkboxes.forEach(cb => {
      cb.checked = checked;
      const id = cb.value;
      if (checked) {
        this.selectedModels.add(id);
      } else {
        this.selectedModels.delete(id);
      }
    });
    this.updateBatchButtons();
  }

  toggleModelSelection(id, checked) {
    if (checked) {
      this.selectedModels.add(id);
    } else {
      this.selectedModels.delete(id);
    }
    // 更新全选框状态
    const selectAll = document.getElementById('selectAllModels');
    const allCheckboxes = document.querySelectorAll('#adminModelsList tbody input[type="checkbox"]');
    selectAll.checked = allCheckboxes.length > 0 && this.selectedModels.size === allCheckboxes.length;
    this.updateBatchButtons();
  }

  updateBatchButtons() {
    const count = this.selectedModels.size;
    const deleteBtn = document.getElementById('batchDeleteModelsBtn');
    const enableBtn = document.getElementById('batchEnableModelsBtn');
    const disableBtn = document.getElementById('batchDisableModelsBtn');
    const setPricesBtn = document.getElementById('batchSetPricesBtn');
    const adjustPricesBtn = document.getElementById('batchAdjustPricesBtn');
    const setRateLimitBtn = document.getElementById('batchSetRateLimitBtn');
    const editDescBtn = document.getElementById('batchEditDescBtn');
    const setSeriesBtn = document.getElementById('batchSetSeriesBtn');
    const adjustByRefBtn = document.getElementById('batchAdjustByRefBtn');
    if (deleteBtn) deleteBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (enableBtn) enableBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (disableBtn) disableBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (setPricesBtn) setPricesBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (adjustPricesBtn) adjustPricesBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (setRateLimitBtn) setRateLimitBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (editDescBtn) editDescBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (setSeriesBtn) setSeriesBtn.style.display = count > 0 ? 'inline-flex' : 'none';

    if (adjustByRefBtn) adjustByRefBtn.style.display = count > 0 ? 'inline-flex' : 'none';
  }

  async batchDeleteModels() {
    const ids = [...this.selectedModels];
    if (ids.length === 0) return;
    if (!confirm(`确定要删除选中的 ${ids.length} 个模型吗？此操作不可撤销。`)) return;

    try {
      const response = await fetch('/api/admin/models/batch-delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids })
      });
      if (response.ok) {
        this.loadModels();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '批量删除失败');
      }
    } catch (error) {
      console.error('批量删除模型失败:', error);
      alert('批量删除失败');
    }
  }

  async batchUpdateModels(enabled) {
    const ids = [...this.selectedModels];
    if (ids.length === 0) return;
    const action = enabled ? '启用' : '禁用';
    if (!confirm(`确定要${action}选中的 ${ids.length} 个模型吗？`)) return;

    try {
      const response = await fetch('/api/admin/models/batch-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, enabled })
      });
      if (response.ok) {
        this.loadModels();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || `批量${action}失败`);
      }
    } catch (error) {
      console.error(`批量${action}模型失败:`, error);
      alert(`批量${action}失败`);
    }
  }

  showAddModelModal() {
    document.getElementById('modelId').value = '';
    document.getElementById('modelId').disabled = false;
    document.getElementById('modelAlias').value = '';
    document.getElementById('modelDescription').value = '';
    document.getElementById('modelInputPrice').value = '0.01';
    document.getElementById('modelOutputPrice').value = '0.01';
    document.getElementById('modelCachedOutputPrice').value = '0';
    document.getElementById('modelRateLimitRpm').value = '0';
    document.getElementById('modelRateLimitTpm').value = '0';
    document.getElementById('modelEnabled').value = 'true';
    
    this.loadProviderOptions().then(() => {
      document.getElementById('modelProvider').value = '';
      document.getElementById('addModelModal').style.display = 'flex';
      document.getElementById('addModelModal').classList.add('active');
    });
  }

  editModel(model) {
    document.getElementById('modelId').value = model.id;
    document.getElementById('modelId').disabled = true;
    document.getElementById('modelAlias').value = model.alias || '';
    document.getElementById('modelSeries').value = model.series || '';
    document.getElementById('modelDescription').value = model.description || '';
    document.getElementById('modelInputPrice').value = model.input_price_per_1k_tokens || 0;
    document.getElementById('modelOutputPrice').value = model.output_price_per_1k_tokens || 0;
    document.getElementById('modelRefInputPrice').value = model.reference_input_price_per_1k_tokens || 0;
    document.getElementById('modelRefOutputPrice').value = model.reference_output_price_per_1k_tokens || 0;
    document.getElementById('modelRateLimitRpm').value = model.rate_limit_rpm || 0;
    document.getElementById('modelRateLimitTpm').value = model.rate_limit_tpm || 0;
    document.getElementById('modelEnabled').value = model.enabled.toString();
    
    this.loadProviderOptions().then(() => {
      document.getElementById('modelProvider').value = model.provider;
      this.loadModelOptions().then(() => {
        document.getElementById('modelThinkingModel').value = model.thinking_model_id || '';
        document.getElementById('modelNonThinkingModel').value = model.non_thinking_model_id || '';
        document.getElementById('addModelModal').style.display = 'flex';
        document.getElementById('addModelModal').classList.add('active');
      });
    });
  }

  async loadModelOptions() {
    try {
      const response = await fetch('/api/admin/models');
      if (!response.ok) return;
      const models = await response.json();
      const options = models.map(m => `<option value="${m.id}">${m.id}</option>`).join('');
      document.getElementById('modelThinkingModel').innerHTML = '<option value="">不设置（使用自身）</option>' + options;
      document.getElementById('modelNonThinkingModel').innerHTML = '<option value="">不设置（使用自身）</option>' + options;
    } catch (error) {
      console.error('加载模型选项失败:', error);
    }
  }

  async loadProviderOptions() {
    try {
      const response = await fetch('/api/admin/providers');
      if (!response.ok) return;
      const providers = await response.json();
      const select = document.getElementById('modelProvider');
      select.innerHTML = providers.map(p => 
        `<option value="${p.id}">${p.name} (${p.id})</option>`
      ).join('');
    } catch (error) {
      console.error('加载供应商选项失败:', error);
    }
  }

  async saveModel() {
    const id = document.getElementById('modelId').value;
    const alias = document.getElementById('modelAlias').value;
    const provider = document.getElementById('modelProvider').value;
    const series = document.getElementById('modelSeries').value;
    const description = document.getElementById('modelDescription').value;
    const input_price_per_1k_tokens = parseFloat(document.getElementById('modelInputPrice').value);
    const output_price_per_1k_tokens = parseFloat(document.getElementById('modelOutputPrice').value);
    const reference_input_price_per_1k_tokens = parseFloat(document.getElementById('modelRefInputPrice').value);
    const reference_output_price_per_1k_tokens = parseFloat(document.getElementById('modelRefOutputPrice').value);
    const rate_limit_rpm = parseInt(document.getElementById('modelRateLimitRpm').value);
    const rate_limit_tpm = parseInt(document.getElementById('modelRateLimitTpm').value);
    const enabled = document.getElementById('modelEnabled').value === 'true';
    const thinking_model_id = document.getElementById('modelThinkingModel').value;
    const non_thinking_model_id = document.getElementById('modelNonThinkingModel').value;

    if (!id || !provider) {
      alert('请填写必填字段');
      return;
    }

    try {
      const response = await fetch('/api/admin/models', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, alias, provider, series, description, input_price_per_1k_tokens, output_price_per_1k_tokens, reference_input_price_per_1k_tokens, reference_output_price_per_1k_tokens, rate_limit_rpm, rate_limit_tpm, enabled, thinking_model_id, non_thinking_model_id })
      });

      if (response.ok) {
        this.closeModals();
        this.loadModels();
        document.getElementById('modelId').disabled = false;
      } else {
        alert('保存失败');
      }
    } catch (error) {
      console.error('保存模型失败:', error);
      alert('保存失败');
    }
  }

  async deleteModel(id) {
    if (!confirm('确定要删除此模型吗？')) return;

    try {
      const response = await fetch(`/api/admin/models/${id}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        this.loadModels();
      } else {
        alert('删除失败');
      }
    } catch (error) {
      console.error('删除模型失败:', error);
      alert('删除失败');
    }
  }

  // 供应商管理
  async loadProviders() {
    try {
      const response = await fetch('/api/admin/providers');
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '加载失败');
      }
      const providers = await response.json();
      
      const container = document.getElementById('adminProvidersList');
      if (providers.length === 0) {
        container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无供应商，点击上方按钮添加</p>';
        return;
      }

      // 获取 OpenAI 供应商的 OAuth 状态
      const openaiProviders = providers.filter(p => p.id === 'openai' || p.oauth_access_token);
      const oauthStatuses = {};
      for (const p of openaiProviders) {
        try {
          const statusRes = await fetch(`/api/admin/providers/${p.id}/openai-status`);
          if (statusRes.ok) {
            oauthStatuses[p.id] = await statusRes.json();
          }
        } catch {}
      }

      container.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>名称</th>
              <th>Base URL</th>
              <th>格式</th>
              <th>状态</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${providers.map(provider => {
              const oauthStatus = oauthStatuses[provider.id];
              let oauthBadge = '';
              if (oauthStatus?.authenticated) {
                oauthBadge = oauthStatus.expired
                  ? '<span style="color:var(#f59e0b);margin-left:6px;font-size:12px;">(令牌已过期)</span>'
                  : '<span style="color:#10b981;margin-left:6px;font-size:12px;">(已登录)</span>';
              }
              return `
              <tr>
                <td>${provider.id}${oauthBadge}</td>
                <td>${provider.name}</td>
                <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${provider.base_url}</td>
                <td>${provider.format}</td>
                <td>${provider.enabled ? '<span style="color:#10b981">启用</span>' : '<span style="color:var(--destructive)">禁用</span>'}</td>
                <td>
                  ${provider.id !== 'test' ? `<button class="btn btn-sm btn-secondary" title="获取模型列表" onclick="adminApp.fetchProviderModels('${provider.id}')">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                      <circle cx="12" cy="12" r="3"/>
                      <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
                    </svg>
                    获取模型
                  </button>` : ''}
                  <button class="btn btn-icon" title="编辑" onclick="adminApp.editProvider(${JSON.stringify(provider).replace(/"/g, '&quot;')})">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                  </button>
                  <button class="btn btn-icon" title="删除" onclick="adminApp.deleteProvider('${provider.id}')">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3 6 5 6 21 6"/>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                  </button>
                </td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      `;
    } catch (error) {
      console.error('加载供应商列表失败:', error);
      document.getElementById('adminProvidersList').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">${error.message || '加载供应商列表失败'}</p>`;
    }
  }

  showAddProviderModal() {
    document.getElementById('providerModalTitle').textContent = '添加供应商';
    document.getElementById('providerId').value = '';
    document.getElementById('providerId').disabled = false;
    document.getElementById('providerName').value = '';
    document.getElementById('providerBaseUrl').value = '';
    document.getElementById('providerApiKey').value = '';
    document.getElementById('providerFormat').value = 'openai';
    document.getElementById('providerEnabled').value = 'true';
    
    document.getElementById('addProviderModal').style.display = 'flex';
    document.getElementById('addProviderModal').classList.add('active');
  }

  // OpenAI OAuth 登录 - 显示 Python 脚本
  async openaiOAuthLogin() {
    const serverUrl = window.location.origin;

    try {
      // 1. 获取一次性认证 token
      const tokenResp = await fetch('/api/admin/providers/openai/auth-token', { method: 'POST' });
      if (!tokenResp.ok) throw new Error('获取认证 token 失败');
      const { token: authToken } = await tokenResp.json();

      // 2. 获取脚本内容
      const resp = await fetch('/api/admin/providers/openai/login-script');
      if (!resp.ok) throw new Error('获取脚本失败');
      const script = await resp.text();

      const cmd = `python openai_login.py --server ${serverUrl} --token ${authToken}`;

      const modal = document.getElementById('openaiLoginModal');
      if (modal) {
        document.getElementById('openaiLoginCmd').textContent = cmd;
        document.getElementById('openaiLoginScript').value = script;
        modal.style.display = 'flex';
        modal.classList.add('active');

        // 绑定复制按钮
        const copyScriptBtn = document.getElementById('copyScriptBtn');
        const copyCmdBtn = document.getElementById('copyCmdBtn');
        if (copyScriptBtn) {
          copyScriptBtn.onclick = () => this._copyToClipboard(document.getElementById('openaiLoginScript').value, copyScriptBtn, '复制脚本');
        }
        if (copyCmdBtn) {
          copyCmdBtn.onclick = () => this._copyToClipboard(cmd, copyCmdBtn, '复制');
        }
      }
    } catch (error) {
      console.error('获取脚本失败:', error);
      alert('获取登录脚本失败: ' + error.message);
    }
  }

  _copyToClipboard(text, btn, originalText) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try {
      document.execCommand('copy');
      btn.textContent = '已复制';
      setTimeout(() => { btn.textContent = originalText; }, 1500);
    } catch {
      alert('复制失败，请手动选择复制');
    }
    document.body.removeChild(textarea);
  }

  closeOpenaiLoginModal() {
    const modal = document.getElementById('openaiLoginModal');
    if (modal) {
      modal.style.display = 'none';
      modal.classList.remove('active');
    }
    this.loadProviders();
  }

  // DeepSeek 账号登录
  openDeepseekLogin() {
    document.getElementById('deepseekEmail').value = '';
    document.getElementById('deepseekPassword').value = '';
    document.getElementById('deepseekAccountName').value = '';
    document.getElementById('deepseekLoginStatus').style.display = 'none';
    document.getElementById('deepseekLoginSubmitBtn').disabled = false;
    document.getElementById('deepseekLoginSubmitBtn').textContent = '添加账号';
    
    document.getElementById('deepseekLoginModal').style.display = 'flex';
    document.getElementById('deepseekLoginModal').classList.add('active');
  }

  closeDeepseekLoginModal() {
    const modal = document.getElementById('deepseekLoginModal');
    if (modal) {
      modal.style.display = 'none';
      modal.classList.remove('active');
    }
    this.loadDeepseekAccounts();
  }

  async submitDeepseekLogin() {
    const email = document.getElementById('deepseekEmail').value.trim();
    const password = document.getElementById('deepseekPassword').value;
    const name = document.getElementById('deepseekAccountName').value.trim();
    const statusEl = document.getElementById('deepseekLoginStatus');
    const submitBtn = document.getElementById('deepseekLoginSubmitBtn');

    if (!email || !password) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '请填写邮箱/手机号和密码';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '添加中...';
    statusEl.style.display = 'block';
    statusEl.style.background = 'rgba(59,130,246,0.1)';
    statusEl.style.color = '#10b981';
    statusEl.textContent = '正在添加账号...';

    try {
      const response = await fetch('/api/admin/providers/deepseek/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, name })
      });

      const result = await response.json();

      if (response.ok && result.success) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '账号添加成功!';
        submitBtn.textContent = '添加账号';
        
        setTimeout(() => {
          this.closeDeepseekLoginModal();
          this.loadDeepseekAccounts();
        }, 1000);
      } else {
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '添加失败';
        submitBtn.disabled = false;
        submitBtn.textContent = '添加账号';
      }
    } catch (error) {
      console.error('DeepSeek 账号添加失败:', error);
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
      submitBtn.disabled = false;
      submitBtn.textContent = '添加账号';
    }
  }

  async loadDeepseekAccounts() {
    try {
      const response = await fetch('/api/admin/providers/deepseek/accounts');
      if (!response.ok) throw new Error('加载失败');
      const accounts = await response.json();
      
      const container = document.getElementById('deepseekAccountsList');
      if (accounts.length === 0) {
        container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无 DeepSeek 账号，点击上方按钮添加</p>';
        return;
      }

      container.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>账号</th>
              <th>名称</th>
              <th>状态</th>
              <th>同步</th>
              <th>添加时间</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${accounts.map(acc => `
              <tr>
                <td>${acc.identifier}</td>
                <td>${acc.name || '-'}</td>
                <td>${acc.enabled ? '<span style="color:#10b981">启用</span>' : '<span style="color:var(--destructive)">禁用</span>'}</td>
                <td>${acc.synced ? '<span style="color:#10b981">已同步</span>' : '<span style="color:var(#f59e0b)">未同步</span>'}</td>
                <td>${new Date(acc.created_at).toLocaleDateString('zh-CN')}</td>
                <td>
                  <button class="btn btn-sm btn-secondary" title="${acc.enabled ? '禁用' : '启用'}" onclick="adminApp.toggleDeepseekAccount(${acc.id})">
                    ${acc.enabled ? '禁用' : '启用'}
                  </button>
                  <button class="btn btn-sm btn-danger" title="删除" onclick="adminApp.deleteDeepseekAccount(${acc.id}, '${acc.identifier}')">
                    删除
                  </button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (error) {
      console.error('加载 DeepSeek 账号列表失败:', error);
      document.getElementById('deepseekAccountsList').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">加载失败</p>`;
    }
  }

  async deleteDeepseekAccount(id, identifier) {
    if (!confirm(`确定要删除账号 ${identifier} 吗？`)) return;

    try {
      const response = await fetch(`/api/admin/providers/deepseek/accounts/${id}`, { method: 'DELETE' });
      if (response.ok) {
        this.loadDeepseekAccounts();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '删除失败');
      }
    } catch (error) {
      console.error('删除 DeepSeek 账号失败:', error);
      alert('删除失败');
    }
  }

  async toggleDeepseekAccount(id) {
    try {
      const response = await fetch(`/api/admin/providers/deepseek/accounts/${id}/toggle`, { method: 'PUT' });
      if (response.ok) {
        this.loadDeepseekAccounts();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '操作失败');
      }
    } catch (error) {
      console.error('切换 DeepSeek 账号状态失败:', error);
      alert('操作失败');
    }
  }

  async syncDeepseekAccounts() {
    const btn = document.getElementById('syncDeepseekBtn');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '同步中...';
    }

    try {
      const response = await fetch('/api/admin/providers/deepseek/sync', { method: 'POST' });
      const result = await response.json();
      if (response.ok && result.success) {
        alert(`同步成功! 已同步 ${result.synced} 个账号到 ds2api`);
        this.loadDeepseekAccounts();
      } else {
        alert(result.error || '同步失败');
      }
    } catch (error) {
      console.error('同步 DeepSeek 账号失败:', error);
      alert('同步失败: ' + error.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>同步到 ds2api`;
      }
    }
  }

  // ========== DS2API Key 管理 ==========

  async loadDs2apiKeys() {
    try {
      const response = await fetch('/api/admin/ds2api-keys');
      if (!response.ok) throw new Error('加载失败');
      const keys = await response.json();

      const container = document.getElementById('ds2apiKeysList');
      if (keys.length === 0) {
        container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无 DS2API Key，点击上方按钮添加</p>';
        return;
      }

      container.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>Key</th>
              <th>名称</th>
              <th>备注</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${keys.map(k => {
              const maskedKey = k.key_value.length > 16
                ? k.key_value.substring(0, 8) + '****' + k.key_value.substring(k.key_value.length - 8)
                : k.key_value;
              return `
              <tr>
                <td><code style="font-size:12px;">${maskedKey}</code></td>
                <td>${k.name || '-'}</td>
                <td>${k.remark || '-'}</td>
                <td>
                  <button class="btn btn-sm btn-secondary" title="编辑" onclick="adminApp.editDs2apiKey(${JSON.stringify(k).replace(/"/g, '&quot;')})">
                    编辑
                  </button>
                  <button class="btn btn-sm btn-danger" title="删除" onclick="adminApp.deleteDs2apiKey(${k.id})">
                    删除
                  </button>
                </td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      `;
    } catch (error) {
      console.error('加载 DS2API Key 列表失败:', error);
      document.getElementById('ds2apiKeysList').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">加载失败</p>`;
    }
  }

  openAddDs2apiKeyModal() {
    document.getElementById('ds2apiKeyModalTitle').textContent = '添加 DS2API Key';
    document.getElementById('ds2apiKeyEditId').value = '';
    document.getElementById('ds2apiKeyValue').value = '';
    document.getElementById('ds2apiKeyValue').disabled = false;
    document.getElementById('ds2apiKeyName').value = '';
    document.getElementById('ds2apiKeyRemark').value = '';
    document.getElementById('ds2apiKeyStatus').style.display = 'none';
    document.getElementById('ds2apiKeySubmitBtn').disabled = false;
    document.getElementById('ds2apiKeySubmitBtn').textContent = '添加';

    document.getElementById('addDs2apiKeyModal').style.display = 'flex';
    document.getElementById('addDs2apiKeyModal').classList.add('active');
  }

  closeAddDs2apiKeyModal() {
    const modal = document.getElementById('addDs2apiKeyModal');
    if (modal) {
      modal.style.display = 'none';
      modal.classList.remove('active');
    }
    this.loadDs2apiKeys();
  }

  editDs2apiKey(key) {
    document.getElementById('ds2apiKeyModalTitle').textContent = '编辑 DS2API Key';
    document.getElementById('ds2apiKeyEditId').value = key.id;
    document.getElementById('ds2apiKeyValue').value = key.key_value;
    document.getElementById('ds2apiKeyValue').disabled = true;
    document.getElementById('ds2apiKeyName').value = key.name || '';
    document.getElementById('ds2apiKeyRemark').value = key.remark || '';
    document.getElementById('ds2apiKeyStatus').style.display = 'none';
    document.getElementById('ds2apiKeySubmitBtn').disabled = false;
    document.getElementById('ds2apiKeySubmitBtn').textContent = '保存';

    document.getElementById('addDs2apiKeyModal').style.display = 'flex';
    document.getElementById('addDs2apiKeyModal').classList.add('active');
  }

  async submitDs2apiKey() {
    const editId = document.getElementById('ds2apiKeyEditId').value;
    const keyValue = document.getElementById('ds2apiKeyValue').value.trim();
    const name = document.getElementById('ds2apiKeyName').value.trim();
    const remark = document.getElementById('ds2apiKeyRemark').value.trim();
    const statusEl = document.getElementById('ds2apiKeyStatus');
    const submitBtn = document.getElementById('ds2apiKeySubmitBtn');

    if (!keyValue && !editId) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '请填写 API Key';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = editId ? '保存中...' : '添加中...';

    try {
      let response;
      if (editId) {
        response = await fetch(`/api/admin/ds2api-keys/${editId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, remark })
        });
      } else {
        response = await fetch('/api/admin/ds2api-keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key_value: keyValue, name, remark })
        });
      }

      const result = await response.json();

      if (response.ok && result.success) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = editId ? '保存成功!' : '添加成功!';
        setTimeout(() => this.closeAddDs2apiKeyModal(), 1000);
      } else {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '操作失败';
        submitBtn.disabled = false;
        submitBtn.textContent = editId ? '保存' : '添加';
      }
    } catch (error) {
      console.error('DS2API Key 操作失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
      submitBtn.disabled = false;
      submitBtn.textContent = editId ? '保存' : '添加';
    }
  }

  async deleteDs2apiKey(id) {
    if (!confirm('确定要删除此 Key 吗？')) return;

    try {
      const response = await fetch(`/api/admin/ds2api-keys/${id}`, { method: 'DELETE' });
      if (response.ok) {
        this.loadDs2apiKeys();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '删除失败');
      }
    } catch (error) {
      console.error('删除 DS2API Key 失败:', error);
      alert('删除失败');
    }
  }

  async syncDs2apiKeys() {
    const btn = document.getElementById('syncDs2apiKeysBtn');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '同步中...';
    }

    try {
      const response = await fetch('/api/admin/ds2api-keys/sync', { method: 'POST' });
      const result = await response.json();
      if (response.ok && result.success) {
        alert(`同步成功! 已同步 ${result.synced} 个 Key 到 ds2api`);
        this.loadDs2apiKeys();
      } else {
        alert(result.error || '同步失败');
      }
    } catch (error) {
      console.error('同步 DS2API Key 失败:', error);
      alert('同步失败: ' + error.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>同步到 ds2api`;
      }
    }
  }

  async lookupProviderInfo() {
    const providerId = document.getElementById('providerId').value.trim();
    if (!providerId) {
      alert('请先输入供应商 ID');
      return;
    }

    try {
      const response = await fetch(`/api/admin/providers/lookup/${encodeURIComponent(providerId)}`);
      if (response.ok) {
        const info = await response.json();
        document.getElementById('providerName').value = info.name || providerId;
        if (info.base_url) document.getElementById('providerBaseUrl').value = info.base_url;
        document.getElementById('providerFormat').value = info.format || 'openai';
      } else {
        alert('未在 models.dev 中找到该供应商，可手动填写');
      }
    } catch (error) {
      console.error('查询供应商信息失败:', error);
      alert('查询失败');
    }
  }

  editProvider(provider) {
    document.getElementById('providerModalTitle').textContent = '编辑供应商';
    document.getElementById('providerId').value = provider.id;
    document.getElementById('providerId').disabled = true;
    document.getElementById('providerName').value = provider.name;
    document.getElementById('providerBaseUrl').value = provider.base_url;
    document.getElementById('providerApiKey').value = '';
    document.getElementById('providerFormat').value = provider.format;
    document.getElementById('providerEnabled').value = provider.enabled.toString();
    
    document.getElementById('addProviderModal').style.display = 'flex';
    document.getElementById('addProviderModal').classList.add('active');
  }

  async saveProvider() {
    const id = document.getElementById('providerId').value;
    const name = document.getElementById('providerName').value;
    const base_url = document.getElementById('providerBaseUrl').value;
    const api_key = document.getElementById('providerApiKey').value;
    const format = document.getElementById('providerFormat').value;
    const enabled = document.getElementById('providerEnabled').value === 'true';

    if (!id || !name || !base_url) {
      alert('请填写必填字段');
      return;
    }

    try {
      const body = { id, name, base_url, format, enabled };
      if (api_key) body.api_key = api_key;

      const response = await fetch('/api/admin/providers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });

      if (response.ok) {
        this.closeModals();
        this.loadProviders();
        document.getElementById('providerId').disabled = false;
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '保存失败');
      }
    } catch (error) {
      console.error('保存供应商失败:', error);
      alert('保存失败');
    }
  }

  async deleteProvider(id) {
    if (!confirm('确定要删除此供应商吗？')) return;

    try {
      const response = await fetch(`/api/admin/providers/${id}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        this.loadProviders();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '删除失败');
      }
    } catch (error) {
      console.error('删除供应商失败:', error);
      alert('删除失败');
    }
  }

  // 获取供应商模型列表
  async fetchProviderModels(providerId) {
    this.currentFetchProviderId = providerId;
    this.fetchedModels = [];
    
    // 显示对话框
    document.getElementById('fetchModelsTitle').textContent = '获取模型列表';
    document.getElementById('fetchModelsLoading').style.display = 'block';
    document.getElementById('fetchModelsError').style.display = 'none';
    document.getElementById('fetchModelsContent').style.display = 'none';
    document.getElementById('addSelectedModelsBtn').style.display = 'none';
    document.getElementById('selectAllFetchedModels').checked = false;
    
    document.getElementById('fetchModelsModal').style.display = 'flex';
    document.getElementById('fetchModelsModal').classList.add('active');

    try {
      const response = await fetch(`/api/admin/providers/${providerId}/fetch-models`);
      const data = await response.json();

      if (!response.ok) {
        document.getElementById('fetchModelsLoading').style.display = 'none';
        document.getElementById('fetchModelsError').style.display = 'block';
        document.getElementById('fetchModelsError').textContent = data.error || '获取失败';
        return;
      }

      if (data.models.length === 0) {
        document.getElementById('fetchModelsLoading').style.display = 'none';
        document.getElementById('fetchModelsError').style.display = 'block';
        document.getElementById('fetchModelsError').style.color = 'var(--muted-foreground)';
        document.getElementById('fetchModelsError').textContent = data.message || '未获取到模型';
        return;
      }

      this.fetchedModels = data.models;
      this.renderFetchedModels(data.provider_name, data.models);
    } catch (error) {
      console.error('获取供应商模型失败:', error);
      document.getElementById('fetchModelsLoading').style.display = 'none';
      document.getElementById('fetchModelsError').style.display = 'block';
      document.getElementById('fetchModelsError').textContent = '网络错误';
    }
  }

  renderFetchedModels(providerName, models) {
    document.getElementById('fetchModelsLoading').style.display = 'none';
    document.getElementById('fetchModelsContent').style.display = 'block';
    document.getElementById('addSelectedModelsBtn').style.display = 'inline-flex';
    
    document.getElementById('fetchedModelsCount').textContent = `共 ${models.length} 个模型`;
    document.getElementById('selectAllFetchedModels').checked = false;

    const container = document.getElementById('fetchedModelsList');
    container.innerHTML = models.map((model, index) => `
      <div class="model-check-item">
        <input type="checkbox" class="checkbox" id="fetchedModel_${index}" value="${model.id}" onchange="adminApp.updateFetchedModelsCount()">
        <label for="fetchedModel_${index}">
          <span class="model-id">${model.id}</span>
          ${model.name !== model.id ? `<span class="model-name">${model.name}</span>` : ''}
        </label>
      </div>
    `).join('');
  }

  toggleSelectAllFetchedModels(checked) {
    const checkboxes = document.querySelectorAll('#fetchedModelsList input[type="checkbox"]');
    checkboxes.forEach(cb => cb.checked = checked);
    this.updateFetchedModelsCount();
  }

  updateFetchedModelsCount() {
    const checked = document.querySelectorAll('#fetchedModelsList input[type="checkbox"]:checked').length;
    const total = document.querySelectorAll('#fetchedModelsList input[type="checkbox"]').length;
    document.getElementById('selectAllFetchedModels').checked = checked > 0 && checked === total;
  }

  async addSelectedModels() {
    const checked = document.querySelectorAll('#fetchedModelsList input[type="checkbox"]:checked');
    if (checked.length === 0) {
      alert('请至少选择一个模型');
      return;
    }

    const modelIds = Array.from(checked).map(cb => cb.value);
    const providerId = this.currentFetchProviderId;

    try {
      const response = await fetch('/api/admin/models/batch-add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ models: modelIds, provider: providerId })
      });

      if (response.ok) {
        const result = await response.json();
        alert(`成功添加 ${result.added} 个模型`);
        this.closeModals();
        this.loadModels();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '添加失败');
      }
    } catch (error) {
      console.error('批量添加模型失败:', error);
      alert('添加失败');
    }
  }

  // OpenCode 配置导入
  showImportOpenCodeModal() {
    document.getElementById('openCodeConfigText').value = '';
    document.getElementById('openCodeConfigFile').value = '';
    document.getElementById('importPreview').style.display = 'none';
    document.getElementById('importPreviewContent').innerHTML = '';
    
    document.getElementById('importOpenCodeModal').style.display = 'flex';
    document.getElementById('importOpenCodeModal').classList.add('active');
  }

  handleConfigFileUpload(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      const content = e.target.result;
      document.getElementById('openCodeConfigText').value = content;
      this.previewConfig(content);
    };
    reader.readAsText(file);
  }

  previewConfig(content) {
    try {
      const config = JSON.parse(content);
      const preview = document.getElementById('importPreview');
      const previewContent = document.getElementById('importPreviewContent');
      
      let html = '';
      
      // Claude Code 格式（有 env 字段）
      if (config.env && typeof config.env === 'object') {
        const env = config.env;
        const key = env.ANTHROPIC_AUTH_TOKEN;
        const baseUrl = env.ANTHROPIC_BASE_URL || 'https://api.anthropic.com';
        
        html += `<p style="color: var(--foreground); margin-bottom: 8px;"><strong>Claude Code 配置</strong></p>`;
        html += `<div style="margin-left: 12px; margin-bottom: 4px;">
          <span style="color: #10b981;">anthropic</span>
          <span style="color: var(--muted-foreground);"> — ${baseUrl}</span>
          ${key ? `<span style="color: #10b981;"> (${key.substring(0, 8)}****)</span>` : '<span style="color: var(--destructive);"> (无 Key)</span>'}
        </div>`;
        
        // 显示模型
        const modelKeys = ['ANTHROPIC_MODEL', 'ANTHROPIC_DEFAULT_HAIKU_MODEL', 'ANTHROPIC_DEFAULT_SONNET_MODEL', 'ANTHROPIC_DEFAULT_OPUS_MODEL'];
        const modelNames = ['默认', 'Haiku', 'Sonnet', 'Opus'];
        for (let i = 0; i < modelKeys.length; i++) {
          const modelId = env[modelKeys[i]];
          if (modelId) {
            html += `<div style="margin-left: 24px; color: var(--muted-foreground); font-size: 12px;">→ ${modelId} (${modelNames[i]})</div>`;
          }
        }
      } else {
        // OpenCode auth.json 格式
        html += '<p style="color: var(--foreground); margin-bottom: 8px;"><strong>OpenCode auth.json</strong></p>';
        let count = 0;
        for (const [id, entry] of Object.entries(config)) {
          if (entry && entry.key) {
            const masked = entry.key.substring(0, 8) + '****';
            html += `<div style="margin-left: 12px; margin-bottom: 4px;">
              <span style="color: #10b981;">${id}</span>
              <span style="color: var(--muted-foreground);"> — ${masked}</span>
            </div>`;
            count++;
          }
        }
        if (count === 0) {
          html += '<p style="color: var(--muted-foreground); margin-left: 12px;">未找到有效的 API Key</p>';
        }
      }
      
      previewContent.innerHTML = html;
      preview.style.display = 'block';
    } catch (error) {
      document.getElementById('importPreview').style.display = 'none';
    }
  }

  async importOpenCodeConfig() {
    const text = document.getElementById('openCodeConfigText').value.trim();
    if (!text) {
      alert('请输入或上传配置内容');
      return;
    }

    let config;
    try {
      config = JSON.parse(text);
    } catch (error) {
      alert('JSON 格式错误: ' + error.message);
      return;
    }

    // 验证格式
    const isClaudeCode = config.env && typeof config.env === 'object';
    const isOpenCode = Object.values(config).some(e => e && e.key);
    
    if (!isClaudeCode && !isOpenCode) {
      alert('未识别的配置格式');
      return;
    }

    try {
      const response = await fetch('/api/admin/import-opencode', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ config })
      });

      if (response.ok) {
        const result = await response.json();
        const { created, updated, models } = result.imported;
        let msg = `导入成功!`;
        if (created > 0) msg += `\n新增: ${created} 个供应商`;
        if (updated > 0) msg += `\n更新: ${updated} 个供应商`;
        if (models > 0) msg += `\n模型: ${models} 个`;
        alert(msg);
        this.closeModals();
        this.loadProviders();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '导入失败');
      }
    } catch (error) {
      console.error('导入 OpenCode 配置失败:', error);
      alert('导入失败');
    }
  }

  async loadStats() {
    try {
      const response = await fetch('/api/admin/stats');
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '加载失败');
      }
      this.stats = await response.json();
      
      this.renderStatsOverview();
      this.renderCharts();
      this.renderDailyBarCharts();
      this.renderModelCharts();
      this.renderProviderCharts();
      
      const container = document.getElementById('detailedStats');
      if (this.stats.daily.length === 0) {
        container.innerHTML = '<p style="text-align: center; color: var(--muted-foreground); padding: 20px;">暂无使用数据</p>';
        return;
      }

      container.innerHTML = `
        <div style="background:var(--muted);border-radius:12px;padding:20px;">
          <h3 style="margin:0 0 16px 0;font-size:14px;">每日详细统计</h3>
          <div style="overflow-x:auto;">
            <table>
              <thead>
                <tr>
                  <th>日期</th>
                  <th>请求数</th>
                  <th>Token使用量</th>
                  <th>费用</th>
                  <th>平均Token/请求</th>
                </tr>
              </thead>
              <tbody>
                ${this.stats.daily.map(usage => {
                  const avgTokens = usage.requests > 0 ? Math.round(usage.tokens / usage.requests) : 0;
                  return `
                  <tr>
                    <td>${new Date(usage.date).toLocaleDateString('zh-CN')}</td>
                    <td>${(usage.requests || 0).toLocaleString()}</td>
                    <td>${(usage.tokens || 0).toLocaleString()}</td>
                    <td>¥${parseFloat(usage.cost || 0).toFixed(4)}</td>
                    <td>${avgTokens.toLocaleString()}</td>
                  </tr>`;
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;

      this.renderModelStatsTable();
      this.renderProviderStatsTable();
    } catch (error) {
      console.error('加载统计数据失败:', error);
      document.getElementById('detailedStats').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">${error.message || '加载统计数据失败'}</p>`;
    }
  }

  renderStatsOverview() {
    if (!this.stats || !this.stats.daily) return;
    
    const daily = [...this.stats.daily].reverse();
    const totalRequests = daily.reduce((sum, d) => sum + parseInt(d.requests || 0, 10), 0);
    const totalTokens = daily.reduce((sum, d) => sum + parseInt(d.tokens || 0, 10), 0);
    const totalCost = daily.reduce((sum, d) => sum + parseFloat(d.cost || 0), 0);
    const dayCount = daily.length || 1;
    const activeModels = this.stats.byModel ? this.stats.byModel.length : 0;
    const activeProviders = this.stats.byProvider ? this.stats.byProvider.length : 0;
    
    document.getElementById('statsTotalRequests').textContent = totalRequests.toLocaleString();
    document.getElementById('statsTotalTokens').textContent = totalTokens.toLocaleString();
    document.getElementById('statsTotalCost').textContent = '¥' + totalCost.toFixed(2);
    document.getElementById('statsAvgDailyRequests').textContent = '日均 ' + Math.round(totalRequests / dayCount).toLocaleString();
    document.getElementById('statsAvgDailyTokens').textContent = '日均 ' + Math.round(totalTokens / dayCount).toLocaleString();
    document.getElementById('statsAvgDailyCost').textContent = '日均 ¥' + (totalCost / dayCount).toFixed(2);
    document.getElementById('statsActiveModels').textContent = activeModels;
    document.getElementById('statsTotalProviders').textContent = '供应商 ' + activeProviders;
    
    const today = new Date().toISOString().split('T')[0];
    const yesterday = new Date(Date.now() - 86400000).toISOString().split('T')[0];
    const todayData = daily.find(d => d.date === today);
    const yesterdayData = daily.find(d => d.date === yesterday);
    
    document.getElementById('todayRequests').textContent = todayData ? parseInt(todayData.requests || 0, 10).toLocaleString() : '0';
    document.getElementById('todayTokens').textContent = todayData ? parseInt(todayData.tokens || 0, 10).toLocaleString() : '0';
    document.getElementById('todayCost').textContent = todayData ? '¥' + parseFloat(todayData.cost || 0).toFixed(2) : '¥0';
    document.getElementById('yesterdayRequests').textContent = yesterdayData ? parseInt(yesterdayData.requests || 0, 10).toLocaleString() : '0';
    document.getElementById('yesterdayTokens').textContent = yesterdayData ? parseInt(yesterdayData.tokens || 0, 10).toLocaleString() : '0';
    document.getElementById('yesterdayCost').textContent = yesterdayData ? '¥' + parseFloat(yesterdayData.cost || 0).toFixed(2) : '¥0';
  }

  switchStatsTab(tab) {
    document.querySelectorAll('.stats-tab').forEach(btn => {
      btn.classList.remove('active');
      btn.style.color = 'var(--muted-foreground)';
      btn.style.borderBottom = '2px solid transparent';
    });
    document.querySelectorAll('.stats-tab-content').forEach(content => {
      content.style.display = 'none';
    });
    
    const activeBtn = document.querySelector(`.stats-tab[onclick*="${tab}"]`);
    if (activeBtn) {
      activeBtn.classList.add('active');
      activeBtn.style.color = 'var(--foreground)';
      activeBtn.style.borderBottom = '2px solid #3b82f6';
    }
    
    const tabContent = document.getElementById('statsTab' + tab.charAt(0).toUpperCase() + tab.slice(1));
    if (tabContent) {
      tabContent.style.display = 'block';
    }
    
    if (tab === 'logs' && !this._usageLogsLoaded) {
      this.loadUsageLogs(1);
      this._usageLogsLoaded = true;
    }
  }

  renderCharts() {
    if (!this.stats || !this.stats.daily || this.stats.daily.length === 0) return;
    if (typeof Chart === 'undefined') return;

    const usage = [...this.stats.daily].reverse();
    const labels = usage.map(u => new Date(u.date).toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' }));
    const requests = usage.map(u => parseInt(u.requests || 0, 10));
    const tokens = usage.map(u => parseInt(u.tokens || 0, 10));
    const costs = usage.map(u => parseFloat(u.cost || 0));
    const avgTokens = usage.map(u => {
      const req = parseInt(u.requests || 0, 10);
      const tok = parseInt(u.tokens || 0, 10);
      return req > 0 ? Math.round(tok / req) : 0;
    });

    const style = getComputedStyle(document.documentElement);
    const textSecondary = style.getPropertyValue('--muted-foreground').trim() || '#94a3b8';
    const borderSubtle = style.getPropertyValue('--border').trim() || 'rgba(148,163,184,0.1)';

    const commonOptions = (title) => ({
      responsive: true,
      maintainAspectRatio: false,
      plugins: { 
        legend: { display: false },
        tooltip: { mode: 'index', intersect: false }
      },
      scales: {
        x: { ticks: { color: textSecondary, font: { size: 10 }, maxTicksLimit: 15 }, grid: { display: false } },
        y: { ticks: { color: textSecondary, font: { size: 10 } }, grid: { color: borderSubtle } }
      },
      interaction: { mode: 'nearest', axis: 'x', intersect: false }
    });

    const dailyCtx = document.getElementById('dailyRequestsChart');
    if (dailyCtx) {
      if (this._dailyChart) this._dailyChart.destroy();
      this._dailyChart = new Chart(dailyCtx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: '请求数',
            data: requests,
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59,130,246,0.15)',
            fill: true,
            tension: 0.4,
            pointRadius: 3,
            pointHoverRadius: 6
          }]
        },
        options: commonOptions('请求数')
      });
    }

    const tokensCtx = document.getElementById('dailyTokensChart');
    if (tokensCtx) {
      if (this._dailyTokensChart) this._dailyTokensChart.destroy();
      this._dailyTokensChart = new Chart(tokensCtx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Token',
            data: tokens,
            borderColor: '#8b5cf6',
            backgroundColor: 'rgba(139,92,246,0.15)',
            fill: true,
            tension: 0.4,
            pointRadius: 3,
            pointHoverRadius: 6
          }]
        },
        options: commonOptions('Token')
      });
    }

    const costCtx = document.getElementById('dailyCostChart');
    if (costCtx) {
      if (this._dailyCostChart) this._dailyCostChart.destroy();
      this._dailyCostChart = new Chart(costCtx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: '费用',
            data: costs,
            borderColor: '#10b981',
            backgroundColor: 'rgba(16,185,129,0.15)',
            fill: true,
            tension: 0.4,
            pointRadius: 3,
            pointHoverRadius: 6
          }]
        },
        options: commonOptions('费用')
      });
    }

    const avgCtx = document.getElementById('dailyAvgTokensChart');
    if (avgCtx) {
      if (this._dailyAvgChart) this._dailyAvgChart.destroy();
      this._dailyAvgChart = new Chart(avgCtx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: '平均Token/请求',
            data: avgTokens,
            borderColor: '#f59e0b',
            backgroundColor: 'rgba(245,158,11,0.15)',
            fill: true,
            tension: 0.4,
            pointRadius: 3,
            pointHoverRadius: 6
          }]
        },
        options: commonOptions('平均Token/请求')
      });
    }
  }

  renderDailyBarCharts() {
    if (!this.stats || !this.stats.daily || this.stats.daily.length === 0) return;
    if (typeof Chart === 'undefined') return;

    const usage = [...this.stats.daily].reverse();
    const labels = usage.map(u => new Date(u.date).toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' }));
    const requests = usage.map(u => parseInt(u.requests || 0, 10));
    const costs = usage.map(u => parseFloat(u.cost || 0));

    const style = getComputedStyle(document.documentElement);
    const textSecondary = style.getPropertyValue('--muted-foreground').trim() || '#94a3b8';
    const borderSubtle = style.getPropertyValue('--border').trim() || 'rgba(148,163,184,0.1)';

    const barOptions = () => ({
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: textSecondary, font: { size: 10 }, maxTicksLimit: 15 }, grid: { display: false } },
        y: { ticks: { color: textSecondary, font: { size: 10 } }, grid: { color: borderSubtle } }
      }
    });

    const barReqCtx = document.getElementById('dailyBarRequestsChart');
    if (barReqCtx) {
      if (this._barReqChart) this._barReqChart.destroy();
      this._barReqChart = new Chart(barReqCtx, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: '请求数',
            data: requests,
            backgroundColor: 'rgba(59,130,246,0.7)',
            borderColor: '#3b82f6',
            borderWidth: 1,
            borderRadius: 4
          }]
        },
        options: barOptions()
      });
    }

    const barCostCtx = document.getElementById('dailyBarCostChart');
    if (barCostCtx) {
      if (this._barCostChart) this._barCostChart.destroy();
      this._barCostChart = new Chart(barCostCtx, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: '费用',
            data: costs,
            backgroundColor: 'rgba(16,185,129,0.7)',
            borderColor: '#10b981',
            borderWidth: 1,
            borderRadius: 4
          }]
        },
        options: barOptions()
      });
    }
  }

  renderModelCharts() {
    if (!this.stats || !this.stats.byModel || this.stats.byModel.length === 0) return;
    if (typeof Chart === 'undefined') return;

    const style = getComputedStyle(document.documentElement);
    const textSecondary = style.getPropertyValue('--muted-foreground').trim() || '#94a3b8';

    const topModels = this.stats.byModel.slice(0, 8);
    const modelLabels = topModels.map(m => {
      const parts = m.model_id.split('/');
      return parts[parts.length - 1] || m.model_id;
    });
    const modelRequests = topModels.map(m => parseInt(m.requests || 0, 10));
    const modelTokens = topModels.map(m => parseInt(m.tokens || 0, 10));
    const modelCosts = topModels.map(m => parseFloat(m.cost || 0));
    const modelAvgTokens = topModels.map(m => {
      const req = parseInt(m.requests || 0, 10);
      const tok = parseInt(m.tokens || 0, 10);
      return req > 0 ? Math.round(tok / req) : 0;
    });

    const colors = ['#3b82f6', '#8b5cf6', '#10b981', '#f59e0b', '#ef4444', '#06b6d4', '#ec4899', '#14b8a6'];

    const doughnutOptions = (title) => ({
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { color: textSecondary, font: { size: 11 }, padding: 10, usePointStyle: true } }
      },
      cutout: '50%'
    });

    const barOptions = () => ({
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: textSecondary, font: { size: 10 } }, grid: { color: 'rgba(148,163,184,0.1)' } },
        y: { ticks: { color: textSecondary, font: { size: 10 } }, grid: { display: false } }
      }
    });

    const modelReqCtx = document.getElementById('modelRequestsChart');
    if (modelReqCtx) {
      if (this._modelReqChart) this._modelReqChart.destroy();
      this._modelReqChart = new Chart(modelReqCtx, {
        type: 'doughnut',
        data: {
          labels: modelLabels,
          datasets: [{ data: modelRequests, backgroundColor: colors, borderWidth: 0 }]
        },
        options: doughnutOptions()
      });
    }

    const modelTokCtx = document.getElementById('modelTokensChart');
    if (modelTokCtx) {
      if (this._modelTokChart) this._modelTokChart.destroy();
      this._modelTokChart = new Chart(modelTokCtx, {
        type: 'doughnut',
        data: {
          labels: modelLabels,
          datasets: [{ data: modelTokens, backgroundColor: colors, borderWidth: 0 }]
        },
        options: doughnutOptions()
      });
    }

    const modelCostCtx = document.getElementById('modelCostChart');
    if (modelCostCtx) {
      if (this._modelCostChart) this._modelCostChart.destroy();
      this._modelCostChart = new Chart(modelCostCtx, {
        type: 'doughnut',
        data: {
          labels: modelLabels,
          datasets: [{ data: modelCosts, backgroundColor: colors, borderWidth: 0 }]
        },
        options: doughnutOptions()
      });
    }

    const modelAvgCtx = document.getElementById('modelAvgTokensChart');
    if (modelAvgCtx) {
      if (this._modelAvgChart) this._modelAvgChart.destroy();
      this._modelAvgChart = new Chart(modelAvgCtx, {
        type: 'bar',
        data: {
          labels: modelLabels,
          datasets: [{
            data: modelAvgTokens,
            backgroundColor: colors,
            borderWidth: 0,
            borderRadius: 4
          }]
        },
        options: barOptions()
      });
    }
  }

