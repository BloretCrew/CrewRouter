  async loadKimi2apiUsers() {
    try {
      const response = await fetch('/api/admin/kimi2api-users');
      if (!response.ok) throw new Error('加载失败');
      const data = await response.json();
      const users = Array.isArray(data) ? data : (data.users || []);
      const container = document.getElementById('kimi2apiUsersList');
      if (users.length === 0) {
        container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无用户</p>';
        return;
      }
      container.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>用户名</th>
              <th>API Key</th>
              <th>配额</th>
              <th>已用</th>
              <th>状态</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${users.map(user => `
              <tr>
                <td style="font-family:monospace;font-size:12px;">${user.id}</td>
                <td>${user.username || '-'}</td>
                <td style="font-family:monospace;font-size:12px;">${user.api_key ? user.api_key.substring(0, 20) + '...' : '-'}</td>
                <td>${user.quota || 0}</td>
                <td>${user.used || 0}</td>
                <td>${user.enabled ? '<span style="color:#10b981">启用</span>' : '<span style="color:var(--destructive)">禁用</span>'}</td>
                <td>
                  <button class="btn btn-sm btn-secondary" onclick="adminApp.editKimi2apiUser(${JSON.stringify(user).replace(/"/g, '&quot;')})">编辑</button>
                  <button class="btn btn-sm btn-secondary" onclick="adminApp.viewKimi2apiUserStats('${user.id}')">统计</button>
                  <button class="btn btn-sm btn-secondary" onclick="adminApp.regenerateKimi2apiUserKey('${user.id}')">重置密钥</button>
                  <button class="btn btn-sm ${user.enabled ? 'btn-danger' : 'btn-secondary'}" onclick="adminApp.toggleKimi2apiUser('${user.id}', ${!user.enabled})">${user.enabled ? '禁用' : '启用'}</button>
                  <button class="btn btn-sm btn-danger" onclick="adminApp.deleteKimi2apiUser('${user.id}')">删除</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (error) {
      console.error('加载 kimi2api 用户列表失败:', error);
    }
  }

