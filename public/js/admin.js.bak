  async loadKimi2apiStats() {
    try {
      const response = await fetch('/api/admin/kimi2api-stats');
      if (!response.ok) throw new Error('加载失败');
      const data = await response.json();
      const overview = data.overview || {};
      document.getElementById('kimi2apiStatsTotalRequests').textContent = overview.total_requests || 0;
      document.getElementById('kimi2apiStatsTotalTokens').textContent = overview.total_tokens || 0;
      document.getElementById('kimi2apiStatsTotalErrors').textContent = overview.total_errors || 0;
      document.getElementById('kimi2apiStatsTodayRequests').textContent = overview.requests_today || 0;
      
      const logs = data.recent_requests || [];
      const logsContainer = document.getElementById('kimi2apiRequestLogs');
      if (logs.length === 0) {
        logsContainer.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无请求日志</p>';
      } else {
        logsContainer.innerHTML = `
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>用户</th>
                <th>模型</th>
                <th>Tokens</th>
                <th>状态</th>
                <th>时间</th>
              </tr>
            </thead>
            <tbody>
              ${logs.map(log => `
                <tr>
                  <td style="font-family:monospace;font-size:12px;">${log.id}</td>
                  <td>${log.user_id || '-'}</td>
                  <td>${log.model || '-'}</td>
                  <td>${log.tokens_used || 0}</td>
                  <td>${log.status === 'success' ? '<span style="color:#10b981">成功</span>' : '<span style="color:var(--destructive)">失败</span>'}</td>
                  <td>${log.timestamp ? new Date(log.timestamp).toLocaleString('zh-CN') : '-'}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      }
    } catch (error) {
      console.error('加载 kimi2api 统计失败:', error);
    }
  }

  async loadKimi2apiConfigSettings() {
    try {
      const response = await fetch('/api/admin/kimi2api-config-settings');
      if (!response.ok) throw new Error('加载失败');
      const data = await response.json();
      document.getElementById('kimi2apiConfigRateLimit').value = data.rate_limit || 60;
      document.getElementById('kimi2apiConfigMaxTokens').value = data.max_tokens_per_request || 4096;
      document.getElementById('kimi2apiConfigEnableLogging').checked = data.enable_logging !== false;
      document.getElementById('kimi2apiConfigAllowedModels').value = data.allowed_models ? JSON.stringify(data.allowed_models, null, 2) : '';
    } catch (error) {
      console.error('加载 kimi2api 系统配置失败:', error);
    }
  }

  async saveKimi2apiConfigSettings() {
    const statusEl = document.getElementById('kimi2apiConfigStatus');
    try {
      const allowedModelsStr = document.getElementById('kimi2apiConfigAllowedModels').value.trim();
      let allowedModels = null;
      if (allowedModelsStr) {
        try {
          allowedModels = JSON.parse(allowedModelsStr);
        } catch (e) {
          statusEl.style.display = 'block';
          statusEl.style.background = 'rgba(239,68,68,0.1)';
          statusEl.style.color = 'var(--destructive)';
          statusEl.textContent = '允许的模型列表 JSON 格式错误';
          return;
        }
      }
      const data = {
        rate_limit: parseInt(document.getElementById('kimi2apiConfigRateLimit').value) || 60,
        max_tokens_per_request: parseInt(document.getElementById('kimi2apiConfigMaxTokens').value) || 4096,
        enable_logging: document.getElementById('kimi2apiConfigEnableLogging').checked
      };
      if (allowedModels) data.allowed_models = allowedModels;
      const response = await fetch('/api/admin/kimi2api-config-settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (response.ok) {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '配置已保存!';
        setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
      } else {
        const err = await response.json().catch(() => ({}));
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = err.error || '保存失败';
      }
    } catch (error) {
      console.error('保存 kimi2api 系统配置失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
    }
  }

  async resetKimi2apiConfig() {
    if (!confirm('确定要将系统配置重置为默认值吗？此操作不可撤销。')) return;
    try {
      const response = await fetch('/api/admin/kimi2api-config/reset', { method: 'POST' });
      if (response.ok) {
        alert('配置已重置为默认值');
        this.loadKimi2apiConfigSettings();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '重置失败');
      }
    } catch (error) {
      console.error('重置 kimi2api 配置失败:', error);
      alert('重置失败');
    }
  }

  // ==================== CrewRouter Team 管理 ====================

  async loadTeams() {
    try {
      const response = await fetch('/api/admin/teams');
      if (!response.ok) throw new Error('加载失败');
      const teams = await response.json();
      this.renderTeamsList(teams);
    } catch (error) {
      console.error('加载 Team 列表失败:', error);
    }
  }

  renderTeamsList(teams) {
    const container = document.getElementById('teamsList');
    if (!teams.length) {
      container.innerHTML = '<div class="empty-state">暂无 Team，点击右上角创建</div>';
      return;
    }
    container.innerHTML = teams.map(team => `
      <div class="team-card" data-team-id="${team.id}">
        <div class="team-card-header">
          <h3>${escapeHtml(team.name)}</h3>
          <span class="badge">${team.member_count} 成员</span>
        </div>
        <p class="team-description">${escapeHtml(team.description || '暂无描述')}</p>
        <div class="team-card-footer">
          <span class="text-muted">${new Date(team.created_at).toLocaleDateString()}</span>
          <button class="btn btn-sm btn-primary" onclick="adminApp.showTeamDetail(${team.id})">管理</button>
        </div>
      </div>
    `).join('');

    // 绑定创建 Team 按钮
    document.getElementById('createTeamBtn').onclick = () => this.showCreateTeamModal();
  }

  showCreateTeamModal() {
    const content = `
      <div style="display:grid;gap:12px;">
        <div class="form-group">
          <label>Team 名称</label>
          <input type="text" id="teamNameInput" class="form-input" placeholder="例如：研发组">
        </div>
        <div class="form-group">
          <label>描述</label>
          <textarea id="teamDescInput" class="form-input" rows="3" placeholder="可选描述"></textarea>
        </div>
      </div>
    `;
    const modal = window.DialogManager.showModal({
      title: '创建 Team',
      content: content,
      footer: `<button class="btn btn-secondary modal-close">取消</button><button class="btn btn-primary" id="confirmCreateTeam">创建</button>`
    });
    document.getElementById('confirmCreateTeam').onclick = async () => {
      const name = document.getElementById('teamNameInput').value.trim();
      const description = document.getElementById('teamDescInput').value.trim();
      if (!name) { alert('名称不能为空'); return; }
      try {
        const res = await fetch('/api/admin/teams', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description })
        });
        if (!res.ok) {
          const err = await res.json();
          alert(err.error || '创建失败');
          return;
        }
        modal.close();
        this.loadTeams();
      } catch (e) { alert('创建失败'); }
    };
  }

  async showTeamDetail(teamId) {
    this.currentTeamId = teamId;
    document.getElementById('teamDetailPanel').style.display = 'block';

    // 加载 Team 成员
    this.loadTeamMembers(teamId);
    // 加载 Team 模型
    this.loadTeamModels(teamId);

    // 绑定按钮事件
    document.getElementById('editTeamBtn').onclick = () => this.showEditTeamModal(teamId);
    document.getElementById('deleteTeamBtn').onclick = () => this.deleteTeam(teamId);
    document.getElementById('addTeamMemberBtn').onclick = () => this.showAddTeamMemberModal(teamId);
    document.getElementById('addTeamModelBtn').onclick = () => this.showAddTeamModelModal(teamId);
  }

  async loadTeamMembers(teamId) {
    try {
      const [membersRes, usersRes] = await Promise.all([
        fetch(`/api/admin/teams/${teamId}/members`),
        fetch('/api/admin/users')
      ]);
      const members = await membersRes.json();
      const users = await usersRes.json();
      this.renderTeamMembers(teamId, members, users);
    } catch (error) {
      console.error('加载 Team 成员失败:', error);
    }
  }

  renderTeamMembers(teamId, members, allUsers) {
    const container = document.getElementById('teamMembersList');
    if (!members.length) {
      container.innerHTML = '<div class="empty-state">暂无成员</div>';
      return;
    }
    container.innerHTML = `<table class="data-table"><thead><tr>
      <th>用户名</th><th>邮箱</th><th>加入时间</th><th>操作</th>
    </tr></thead><tbody>${members.map(m => `<tr>
      <td>${escapeHtml(m.username)}</td>
      <td>${escapeHtml(m.email || '-')}</td>
      <td>${new Date(m.created_at).toLocaleDateString()}</td>
      <td><button class="btn btn-sm btn-danger" onclick="adminApp.removeTeamMember(${teamId}, ${m.id})">移除</button></td>
    </tr>`).join('')}</tbody></table>`;
  }

  async removeTeamMember(teamId, userId) {
    if (!confirm('确定移除此成员？')) return;
    try {
      await fetch(`/api/admin/teams/${teamId}/members/${userId}`, { method: 'DELETE' });
      this.loadTeamMembers(teamId);
      this.loadTeams(); // 刷新成员数
    } catch (e) { alert('移除失败'); }
  }

  async showAddTeamMemberModal(teamId) {
    try {
      const [membersRes, usersRes] = await Promise.all([
        fetch(`/api/admin/teams/${teamId}/members`),
        fetch('/api/admin/users')
      ]);
      const members = await membersRes.json();
      const users = await usersRes.json();
      const memberIds = new Set(members.map(m => m.id));
      const available = users.filter(u => !memberIds.has(u.id));

      const content = available.length
        ? `<div style="max-height:400px;overflow-y:auto;">${available.map(u => `
          <label style="display:flex;align-items:center;gap:8px;padding:8px;border-bottom:1px solid var(--border);">
            <input type="checkbox" value="${u.id}" class="team-member-checkbox">
            <span>${escapeHtml(u.username)}</span>
            <span class="text-muted">${escapeHtml(u.email || '')}</span>
            ${u.team_name ? `<span class="badge">${escapeHtml(u.team_name)}</span>` : ''}
          </label>`).join('')}</div>`
        : '<div class="empty-state">所有用户都已在此 Team 中</div>';

      const modal = window.DialogManager.showModal({
        title: '添加成员',
        content: content,
        footer: `<button class="btn btn-secondary modal-close">取消</button><button class="btn btn-primary" id="confirmAddMembers">添加</button>`
      });

      if (available.length) {
        document.getElementById('confirmAddMembers').onclick = async () => {
          const checked = Array.from(document.querySelectorAll('.team-member-checkbox:checked')).map(c => parseInt(c.value));
          if (!checked.length) { alert('请选择用户'); return; }
          try {
            await fetch(`/api/admin/teams/${teamId}/members`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ userIds: checked })
            });
            modal.close();
            this.loadTeamMembers(teamId);
            this.loadTeams();
          } catch (e) { alert('添加失败'); }
        };
      }
    } catch (e) { alert('加载用户列表失败'); }
  }

  async loadTeamModels(teamId) {
    try {
      const [teamModelsRes, allModelsRes] = await Promise.all([
        fetch(`/api/admin/teams/${teamId}/models`),
        fetch('/api/admin/models')
      ]);
      const teamModels = await teamModelsRes.json();
      const allModels = await allModelsRes.json();
      this.renderTeamModels(teamId, teamModels, allModels);
    } catch (error) {
      console.error('加载 Team 模型失败:', error);
    }
  }

  renderTeamModels(teamId, teamModels, allModels) {
    const container = document.getElementById('teamModelsList');
    if (!teamModels.length) {
      container.innerHTML = '<div class="empty-state">暂无可用模型，请添加</div>';
      return;
    }
    const byProvider = {};
    teamModels.forEach(m => {
      if (!byProvider[m.provider]) byProvider[m.provider] = [];
      byProvider[m.provider].push(m);
    });
    container.innerHTML = Object.entries(byProvider).map(([provider, models]) => `
      <div class="provider-group">
        <h4>${escapeHtml(provider)}</h4>
        <div class="model-list">${models.map(m => `
          <div class="model-item ${m.enabled ? '' : 'disabled'}">
            <div class="model-info">
              <span class="model-name">${escapeHtml(m.name)}</span>
              <span class="model-id">${escapeHtml(m.model_id)}</span>
            </div>
            <div class="model-actions">
              <button class="btn btn-sm ${m.enabled ? 'btn-secondary' : 'btn-primary'}"
                onclick="adminApp.toggleTeamModel(${teamId}, '${m.model_id}', ${!m.enabled})">
                ${m.enabled ? '禁用' : '启用'}
              </button>
              <button class="btn btn-sm btn-danger" onclick="adminApp.removeTeamModel(${teamId}, '${m.model_id}')">移除</button>
            </div>
          </div>
        `).join('')}</div>
      </div>
    `).join('');
  }

  async toggleTeamModel(teamId, modelId, enabled) {
    try {
      await fetch(`/api/admin/teams/${teamId}/models/${modelId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled })
      });
      this.loadTeamModels(teamId);
    } catch (e) { alert('操作失败'); }
  }

  async removeTeamModel(teamId, modelId) {
    if (!confirm('确定移除此模型？')) return;
    try {
      await fetch(`/api/admin/teams/${teamId}/models/${modelId}`, { method: 'DELETE' });
      this.loadTeamModels(teamId);
    } catch (e) { alert('移除失败'); }
  }

  async showAddTeamModelModal(teamId) {
    try {
      const [teamModelsRes, allModelsRes] = await Promise.all([
        fetch(`/api/admin/teams/${teamId}/models`),
        fetch('/api/admin/models')
      ]);
      const teamModels = await teamModelsRes.json();
      const allModels = await allModelsRes.json();
      const teamModelIds = new Set(teamModels.map(m => m.model_id));
      const available = allModels.filter(m => m.enabled && !teamModelIds.has(m.id));

      const byProvider = {};
      available.forEach(m => {
        if (!byProvider[m.provider]) byProvider[m.provider] = [];
        byProvider[m.provider].push(m);
      });

      const content = available.length
        ? `<div style="max-height:400px;overflow-y:auto;">${Object.entries(byProvider).map(([provider, models]) => `
          <div style="margin-bottom:12px;">
            <strong>${escapeHtml(provider)}</strong>
            ${models.map(m => `
              <label style="display:flex;align-items:center;gap:8px;padding:6px 8px;">
                <input type="checkbox" value="${m.id}" class="team-model-checkbox">
                <span>${escapeHtml(m.name)}</span>
                <span class="text-muted">${escapeHtml(m.id)}</span>
              </label>
            `).join('')}
          </div>
        `).join('')}</div>`
        : '<div class="empty-state">所有模型都已添加</div>';

      const modal = window.DialogManager.showModal({
        title: '添加模型',
        content: content,
        footer: `<button class="btn btn-secondary modal-close">取消</button><button class="btn btn-primary" id="confirmAddModels">添加</button>`
      });

      if (available.length) {
        document.getElementById('confirmAddModels').onclick = async () => {
          const checked = Array.from(document.querySelectorAll('.team-model-checkbox:checked')).map(c => c.value);
          if (!checked.length) { alert('请选择模型'); return; }
          try {
            await fetch(`/api/admin/teams/${teamId}/models`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ modelIds: checked })
            });
            modal.close();
            this.loadTeamModels(teamId);
          } catch (e) { alert('添加失败'); }
        };
      }
    } catch (e) { alert('加载模型列表失败'); }
  }

  async showEditTeamModal(teamId) {
    try {
      const res = await fetch('/api/admin/teams');
      const teams = await res.json();
      const team = teams.find(t => t.id === teamId);
      if (!team) { alert('Team 不存在'); return; }

      const content = `
        <div style="display:grid;gap:12px;">
          <div class="form-group">
            <label>Team 名称</label>
            <input type="text" id="editTeamNameInput" class="form-input" value="${escapeHtml(team.name)}">
          </div>
          <div class="form-group">
            <label>描述</label>
            <textarea id="editTeamDescInput" class="form-input" rows="3">${escapeHtml(team.description || '')}</textarea>
          </div>
        </div>
      `;
      const modal = window.DialogManager.showModal({
        title: '编辑 Team',
        content: content,
        footer: `<button class="btn btn-secondary modal-close">取消</button><button class="btn btn-primary" id="confirmEditTeam">保存</button>`
      });
      document.getElementById('confirmEditTeam').onclick = async () => {
        const name = document.getElementById('editTeamNameInput').value.trim();
        const description = document.getElementById('editTeamDescInput').value.trim();
        if (!name) { alert('名称不能为空'); return; }
        try {
          await fetch(`/api/admin/teams/${teamId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, description })
          });
          modal.close();
          this.loadTeams();
          this.showTeamDetail(teamId);
        } catch (e) { alert('保存失败'); }
      };
    } catch (e) { alert('加载 Team 信息失败'); }
  }

  async deleteTeam(teamId) {
    if (!confirm('确定删除此 Team？成员将被移除但不会被删除。')) return;
    try {
      await fetch(`/api/admin/teams/${teamId}`, { method: 'DELETE' });
      document.getElementById('teamDetailPanel').style.display = 'none';
      this.loadTeams();
    } catch (e) { alert('删除失败'); }
  }
}

// 初始化应用
let adminApp;
document.addEventListener('DOMContentLoaded', () => {
  adminApp = new AdminApp();
});
