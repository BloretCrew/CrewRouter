        }, 1500);
      } else {
        const err = await response.json().catch(() => ({}));
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = err.error || '设置失败';
      }
    } catch (error) {
      console.error('批量设置系列失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    }
  }

  // 系列图标管理
  async showSeriesIconsModal() {
    document.getElementById('seriesIconsModal').style.display = 'flex';
    document.getElementById('seriesIconsModal').classList.add('active');
    await this.loadSeriesNames();
    await this.loadSeriesIcons();
  }

  async loadSeriesNames() {
    try {
      const select = document.getElementById('newSeriesName');
      select.innerHTML = '<option value="">选择系列...</option>';
      const seriesSet = new Set();
      this.modelsData.forEach(m => {
        if (m.series) seriesSet.add(m.series);
      });
      Array.from(seriesSet).sort().forEach(name => {
        select.innerHTML += `<option value="${name}">${name}</option>`;
      });
    } catch (error) {
      console.error('加载系列列表失败:', error);
    }
  }

  async loadSeriesIcons() {
    try {
      const response = await fetch('/api/admin/series-icons');
      if (!response.ok) return;
      const icons = await response.json();
      const listEl = document.getElementById('seriesIconsList');
      if (icons.length === 0) {
        listEl.innerHTML = '<div style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无系列图标</div>';
        return;
      }
      listEl.innerHTML = icons.map(icon => `
        <div style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;">
          ${icon.icon_url ? `<img src="${icon.icon_url}" style="width:32px;height:32px;object-fit:contain;border-radius:4px;" onerror="this.style.display='none'">` : '<div style="width:32px;height:32px;background:var(--muted);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--muted-foreground);">无</div>'}
          <div style="flex:1;">
            <div style="font-weight:500;">${icon.name}</div>
            <div style="font-size:12px;color:var(--muted-foreground);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${icon.icon_url || '未设置图标'}</div>
          </div>
          <button class="btn btn-icon" title="编辑" onclick="adminApp.editSeriesIcon('${icon.name}', '${icon.icon_url || ''}')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </button>
          <button class="btn btn-icon" title="删除" onclick="adminApp.deleteSeriesIcon('${icon.name}')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
        </div>
      `).join('');
    } catch (error) {
      console.error('加载系列图标失败:', error);
    }
  }

  async addSeriesIcon() {
    const name = document.getElementById('newSeriesName').value.trim();
    const icon_url = document.getElementById('newSeriesIconUrl').value.trim();
    if (!name) {
      alert('请输入系列名称');
      return;
    }
    try {
      const response = await fetch('/api/admin/series-icons', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, icon_url })
      });
      if (response.ok) {
        document.getElementById('newSeriesName').value = '';
        document.getElementById('newSeriesIconUrl').value = '';
        await this.loadSeriesIcons();
      } else {
        alert('添加失败');
      }
    } catch (error) {
      alert('网络错误: ' + error.message);
    }
  }

  editSeriesIcon(name, currentUrl) {
    const newUrl = prompt(`设置 "${name}" 的图标 URL:`, currentUrl);
    if (newUrl === null) return;
    fetch('/api/admin/series-icons', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, icon_url: newUrl })
    }).then(() => this.loadSeriesIcons());
  }

  async deleteSeriesIcon(name) {
    if (!confirm(`确定要删除系列 "${name}" 的图标配置吗？`)) return;
    try {
      await fetch(`/api/admin/series-icons/${encodeURIComponent(name)}`, { method: 'DELETE' });
      await this.loadSeriesIcons();
    } catch (error) {
      alert('删除失败: ' + error.message);
    }
  }

  // 按参考价百分比批量设置价格
  showBatchAdjustByRefModal() {
    const count = this.selectedModels.size;
    if (count === 0) return;
    document.getElementById('batchAdjustByRefCount').textContent = count;
    document.getElementById('batchRefInputPct').value = '100';
    document.getElementById('batchRefOutputPct').value = '100';
    document.getElementById('batchAdjustByRefPreview').style.display = 'none';
    document.getElementById('batchAdjustByRefPreviewBody').innerHTML = '';
    document.getElementById('batchAdjustByRefStatus').style.display = 'none';
    document.getElementById('batchAdjustByRefConfirmBtn').style.display = 'none';
    document.getElementById('batchAdjustByRefModal').style.display = 'flex';
    document.getElementById('batchAdjustByRefModal').classList.add('active');
  }

  async previewBatchAdjustByRef() {
    const ids = [...this.selectedModels];
    if (ids.length === 0) return;

    const inputPct = parseFloat(document.getElementById('batchRefInputPct').value);
    const outputPct = parseFloat(document.getElementById('batchRefOutputPct').value);

    if (isNaN(inputPct) || isNaN(outputPct)) {
      alert('请输入有效的百分比');
      return;
    }

    try {
      const response = await fetch('/api/admin/models/batch-adjust-by-reference-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, input_pct: inputPct, output_pct: outputPct })
      });

      if (response.ok) {
        const data = await response.json();
        const tbody = document.getElementById('batchAdjustByRefPreviewBody');
        tbody.innerHTML = data.preview.map(m => `
          <tr>
            <td style="padding:6px 8px;border-bottom:1px solid var(--border);">${m.name || m.id}</td>
            <td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--border);">¥${m.current_input.toFixed(4)}</td>
            <td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--border);color:var(--muted-foreground);">${m.ref_input > 0 ? '¥' + m.ref_input.toFixed(4) : '-'}</td>
            <td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--border);font-weight:600;color:var(--brand-blue);">${m.new_input != null ? '¥' + m.new_input.toFixed(4) : '-'}</td>
            <td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--border);">¥${m.current_output.toFixed(4)}</td>
            <td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--border);color:var(--muted-foreground);">${m.ref_output > 0 ? '¥' + m.ref_output.toFixed(4) : '-'}</td>
            <td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--border);font-weight:600;color:var(--brand-blue);">${m.new_output != null ? '¥' + m.new_output.toFixed(4) : '-'}</td>
          </tr>
        `).join('');
        document.getElementById('batchAdjustByRefPreview').style.display = 'block';
        document.getElementById('batchAdjustByRefConfirmBtn').style.display = 'inline-flex';
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '预览失败');
      }
    } catch (error) {
      console.error('预览失败:', error);
      alert('预览失败: ' + error.message);
    }
  }

  async executeBatchAdjustByRef() {
    const ids = [...this.selectedModels];
    if (ids.length === 0) return;

    const inputPct = parseFloat(document.getElementById('batchRefInputPct').value);
    const outputPct = parseFloat(document.getElementById('batchRefOutputPct').value);

    if (isNaN(inputPct) || isNaN(outputPct)) {
      alert('请输入有效的百分比');
      return;
    }

    if (!confirm(`确定要将选中的 ${ids.length} 个模型的价格设置为参考价的 ${inputPct}%/${outputPct}% 吗？`)) {
      return;
    }

    const statusEl = document.getElementById('batchAdjustByRefStatus');
    try {
      const response = await fetch('/api/admin/models/batch-adjust-by-reference', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, input_pct: inputPct, output_pct: outputPct })
      });

      if (response.ok) {
        const result = await response.json();
        statusEl.style.display = 'block';
        statusEl.style.color = '#10b981';
        statusEl.textContent = `成功设置 ${result.updated || ids.length} 个模型的价格`;
        this.loadModels();
        setTimeout(() => this.closeModals(), 1500);
      } else {
        const err = await response.json().catch(() => ({}));
        statusEl.style.display = 'block';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = err.error || '设置失败';
      }
    } catch (error) {
      console.error('按参考价设置价格失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '设置失败: ' + error.message;
    }
  }

  // ========== 兑换码管理 ==========

  async loadRedemptionCodes() {
    try {
      const response = await fetch('/api/admin/redemption-codes');
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '加载失败');
      }
      this.allCodes = await response.json();
      this.selectedCodes = new Set();
      this.updateCodeBatchButtons();
      this.updateCodeFilterOptions();
      this.renderCodes();
    } catch (error) {
      console.error('加载兑换码列表失败:', error);
      document.getElementById('redemptionCodesList').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">${error.message || '加载兑换码列表失败'}</p>`;
    }
  }

  updateCodeFilterOptions() {
    if (!this.allCodes) return;
    
    const batchNames = [...new Set(this.allCodes.map(c => c.batch_name).filter(Boolean))].sort();
    const creators = [...new Set(this.allCodes.map(c => c.created_by_name).filter(Boolean))].sort();
    
    const batchSelect = document.getElementById('codeFilterBatch');
    const creatorSelect = document.getElementById('codeFilterCreator');
    
    if (batchSelect) {
      const currentBatch = batchSelect.value;
      batchSelect.innerHTML = '<option value="all">全部批次</option>' + 
        batchNames.map(name => `<option value="${name}" ${name === currentBatch ? 'selected' : ''}>${name}</option>`).join('');
    }
    
    if (creatorSelect) {
      const currentCreator = creatorSelect.value;
      creatorSelect.innerHTML = '<option value="all">全部创建者</option>' + 
        creators.map(name => `<option value="${name}" ${name === currentCreator ? 'selected' : ''}>${name}</option>`).join('');
    }
  }

  renderCodes() {
    const codes = this.getFilteredCodes();
    const container = document.getElementById('redemptionCodesList');
    const countEl = document.getElementById('codeFilterCount');
    const total = this.allCodes ? this.allCodes.length : 0;
    countEl.textContent = codes.length === total ? `共 ${total} 条` : `${codes.length} / ${total} 条`;

    if (codes.length === 0) {
      container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:40px;">没有匹配的兑换码</p>';
      return;
    }

    container.innerHTML = `
      <table>
        <thead>
          <tr>
            <th style="width:40px;"><input type="checkbox" class="checkbox" id="selectAllCodes" onchange="adminApp.toggleSelectAllCodes(this.checked)"></th>
            <th>兑换码</th>
            <th>面额</th>
            <th>类型</th>
            <th>使用次数</th>
            <th>过期时间</th>
            <th>批次</th>
            <th>创建者</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          ${codes.map(code => {
            const isExpired = code.expires_at && new Date(code.expires_at) < new Date();
            const isUsedUp = code.max_uses > 0 && code.used_count >= code.max_uses;
            const statusColor = isExpired ? 'var(--destructive)' : isUsedUp ? 'var(--muted-foreground)' : '#10b981';
            const typeBadge = code.refundable
              ? '<span style="background:rgba(59,130,246,0.15);color:#3b82f6;padding:2px 8px;border-radius:10px;font-size:11px;">可退款</span>'
              : '<span style="background:var(--muted);color:var(--muted-foreground);padding:2px 8px;border-radius:10px;font-size:11px;">普通</span>';
            const feeRateText = code.refundable && code.fee_rate > 0 ? ` <span style="font-size:10px;color:var(--muted-foreground)">(费率${(code.fee_rate * 100).toFixed(0)}%)</span>` : '';
            return `
            <tr>
              <td><input type="checkbox" class="checkbox" value="${code.id}" onchange="adminApp.toggleCodeSelection(${code.id}, this.checked)"></td>
              <td><code style="font-size:12px;">${code.code}</code></td>
              <td>¥${parseFloat(code.amount).toFixed(2)}</td>
              <td>${typeBadge}${feeRateText}</td>
              <td><span style="color:${statusColor}">${code.used_count}${code.max_uses > 0 ? ' / ' + code.max_uses : ' / ∞'}</span></td>
              <td>${code.expires_at ? new Date(code.expires_at).toLocaleString('zh-CN') : '<span style="color:var(--muted-foreground)">永不过期</span>'}</td>
              <td>${code.batch_name || '-'}</td>
              <td>${code.created_by_name || '-'}</td>
              <td>${new Date(code.created_at).toLocaleDateString('zh-CN')}</td>
              <td>
                <button class="btn btn-icon" title="编辑" onclick="adminApp.showEditCode(${code.id})">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                  </svg>
                </button>
                <button class="btn btn-icon" title="删除" onclick="adminApp.deleteRedemptionCode(${code.id})">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  </svg>
                </button>
              </td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  getFilteredCodes() {
    if (!this.allCodes) return [];
    const search = (document.getElementById('codeFilterSearch')?.value || '').toLowerCase().trim();
    const typeFilter = document.getElementById('codeFilterType')?.value || 'all';
    const statusFilter = document.getElementById('codeFilterStatus')?.value || 'all';
    const batchFilter = document.getElementById('codeFilterBatch')?.value || 'all';
    const creatorFilter = document.getElementById('codeFilterCreator')?.value || 'all';
    const minAmount = parseFloat(document.getElementById('codeFilterMinAmount')?.value);
    const maxAmount = parseFloat(document.getElementById('codeFilterMaxAmount')?.value);
    const startDate = document.getElementById('codeFilterStartDate')?.value;
    const endDate = document.getElementById('codeFilterEndDate')?.value;

    return this.allCodes.filter(code => {
      // Search filter
      if (search && !code.code.toLowerCase().includes(search) && !(code.batch_name || '').toLowerCase().includes(search)) {
        return false;
      }
      // Type filter
      if (typeFilter === 'normal' && code.refundable) return false;
      if (typeFilter === 'refundable' && !code.refundable) return false;
      // Status filter
      const isExpired = code.expires_at && new Date(code.expires_at) < new Date();
      const isUsedUp = code.max_uses > 0 && code.used_count >= code.max_uses;
      if (statusFilter === 'active' && (isExpired || isUsedUp)) return false;
      if (statusFilter === 'expired' && !isExpired) return false;
      if (statusFilter === 'used_up' && !isUsedUp) return false;
      // Batch filter
      if (batchFilter !== 'all' && (code.batch_name || '') !== batchFilter) return false;
      // Creator filter
      if (creatorFilter !== 'all' && (code.created_by_name || '') !== creatorFilter) return false;
      // Amount filter
      const amount = parseFloat(code.amount);
      if (!isNaN(minAmount) && amount < minAmount) return false;
      if (!isNaN(maxAmount) && amount > maxAmount) return false;
      // Date filter
      if (startDate) {
        const createdDate = new Date(code.created_at);
        const filterStart = new Date(startDate);
        if (createdDate < filterStart) return false;
      }
      if (endDate) {
        const createdDate = new Date(code.created_at);
        const filterEnd = new Date(endDate);
        filterEnd.setHours(23, 59, 59, 999);
        if (createdDate > filterEnd) return false;
      }
      return true;
    });
  }

  filterCodes() {
    this.renderCodes();
  }

  toggleSelectAllCodes(checked) {
    const checkboxes = document.querySelectorAll('#redemptionCodesList tbody input[type="checkbox"]');
    checkboxes.forEach(cb => {
      cb.checked = checked;
      const id = parseInt(cb.value);
      if (checked) this.selectedCodes.add(id);
      else this.selectedCodes.delete(id);
    });
    this.updateCodeBatchButtons();
  }

  toggleCodeSelection(id, checked) {
    if (checked) this.selectedCodes.add(id);
    else this.selectedCodes.delete(id);
    // Update select-all checkbox state
    const selectAll = document.getElementById('selectAllCodes');
    const allCheckboxes = document.querySelectorAll('#redemptionCodesList tbody input[type="checkbox"]');
    const checkedCount = document.querySelectorAll('#redemptionCodesList tbody input[type="checkbox"]:checked').length;
    if (selectAll) {
      selectAll.checked = allCheckboxes.length > 0 && checkedCount === allCheckboxes.length;
      selectAll.indeterminate = checkedCount > 0 && checkedCount < allCheckboxes.length;
    }
    this.updateCodeBatchButtons();
  }

  updateCodeBatchButtons() {
    const count = this.selectedCodes ? this.selectedCodes.size : 0;
    const deleteBtn = document.getElementById('batchDeleteCodesBtn');
    const refundBtn = document.getElementById('batchSetRefundableBtn');
    const displayBtn = document.getElementById('batchDisplayCodesBtn');
    if (deleteBtn) deleteBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (refundBtn) refundBtn.style.display = count > 0 ? 'inline-flex' : 'none';
    if (displayBtn) displayBtn.style.display = count > 0 ? 'inline-flex' : 'none';
  }

  showBatchSetRefundableModal() {
    const count = this.selectedCodes ? this.selectedCodes.size : 0;
    if (count === 0) return;
    document.getElementById('batchSetCount').textContent = count;
    document.getElementById('batchSetRefundable').checked = true;
    document.getElementById('batchSetFeeRate').value = '0';
    document.getElementById('batchSetFeeRateGroup').style.display = 'block';
    document.getElementById('batchSetRefundableModal').style.display = 'flex';
    document.getElementById('batchSetRefundableModal').classList.add('active');
  }

  showBatchDisplayCodesModal() {
    const count = this.selectedCodes ? this.selectedCodes.size : 0;
    if (count === 0) return;
    
    const selectedIds = [...this.selectedCodes];
    const codes = (this.allCodes || []).filter(c => selectedIds.includes(c.id));
    const codesText = codes.map(c => c.code).join('\n');
    
    document.getElementById('batchDisplayCodesCount').textContent = codes.length;
    document.getElementById('batchDisplayCodesList').value = codesText;
    
    document.getElementById('copyBatchDisplayCodesBtn').onclick = () => {
      const textarea = document.getElementById('batchDisplayCodesList');
      textarea.select();
      try {
        document.execCommand('copy');
        document.getElementById('copyBatchDisplayCodesBtn').textContent = '已复制';
        setTimeout(() => { document.getElementById('copyBatchDisplayCodesBtn').textContent = '复制全部'; }, 1500);
      } catch {
        alert('复制失败，请手动选择复制');
      }
    };
    
    document.getElementById('batchDisplayCodesModal').style.display = 'flex';
    document.getElementById('batchDisplayCodesModal').classList.add('active');
  }

  async batchSetRefundable() {
    const ids = [...(this.selectedCodes || [])];
    if (ids.length === 0) return;
    const refundable = document.getElementById('batchSetRefundable').checked;
    const feeRate = parseFloat(document.getElementById('batchSetFeeRate').value) || 0;

    const btn = document.getElementById('confirmBatchSetBtn');
    btn.disabled = true;
    btn.textContent = '设置中...';

    try {
      const response = await fetch('/api/admin/redemption-codes/batch-set-refundable', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, refundable, feeRate })
      });
      const result = await response.json();
      if (response.ok && result.success) {
        this.closeModals();
        this.selectedCodes = new Set();
        this.loadRedemptionCodes();
      } else {
        alert(result.error || '设置失败');
      }
    } catch (error) {
      console.error('批量设置可退款失败:', error);
      alert('设置失败');
    } finally {
      btn.disabled = false;
      btn.textContent = '确认设置';
    }
  }

  showGenerateCodesModal() {
    document.getElementById('codeAmount').value = '1';
    document.getElementById('codeCount').value = '1';
    document.getElementById('codeMaxUses').value = '1';
    document.getElementById('codeExpiresAt').value = '';
    document.getElementById('codeBatchName').value = '';
    document.getElementById('codeRefundable').checked = false;
    document.getElementById('codeFeeRate').value = '0';
    document.getElementById('codeFeeRateGroup').style.display = 'none';
    document.getElementById('generateCodesModal').style.display = 'flex';
    document.getElementById('generateCodesModal').classList.add('active');
  }

  async generateRedemptionCodes() {
    const amount = parseFloat(document.getElementById('codeAmount').value);
    const count = parseInt(document.getElementById('codeCount').value);
    const maxUses = parseInt(document.getElementById('codeMaxUses').value);
    const expiresAt = document.getElementById('codeExpiresAt').value || null;
    const batchName = document.getElementById('codeBatchName').value.trim() || null;
    const refundable = document.getElementById('codeRefundable').checked;
    const feeRate = parseFloat(document.getElementById('codeFeeRate').value) || 0;

    if (isNaN(amount) || amount <= 0) {
      alert('请输入有效的兑换金额');
      return;
    }
    if (isNaN(count) || count < 1 || count > 1000) {
      alert('生成数量必须在 1-1000 之间');
      return;
    }

    const btn = document.getElementById('confirmGenerateCodesBtn');
    btn.disabled = true;
    btn.textContent = '生成中...';

    try {
      const response = await fetch('/api/admin/redemption-codes/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount, count, maxUses: maxUses || 0, expiresAt, batchName, refundable, feeRate })
      });

      const result = await response.json();
      if (response.ok && result.success) {
        this.closeModals();

        const codesText = result.codes.map(c => c.code).join('\n');
        document.getElementById('generatedCodesCount').textContent = result.codes.length;
        document.getElementById('generatedCodesList').value = codesText;
        document.getElementById('codesResultModal').style.display = 'flex';
        document.getElementById('codesResultModal').classList.add('active');

        document.getElementById('copyGeneratedCodesBtn').onclick = () => {
          const textarea = document.getElementById('generatedCodesList');
          textarea.select();
          try {
            document.execCommand('copy');
            document.getElementById('copyGeneratedCodesBtn').textContent = '已复制';
            setTimeout(() => { document.getElementById('copyGeneratedCodesBtn').textContent = '复制全部'; }, 1500);
          } catch {}
        };

        this.loadRedemptionCodes();
      } else {
        alert(result.error || '生成失败');
      }
    } catch (error) {
      console.error('生成兑换码失败:', error);
      alert('生成失败');
    } finally {
      btn.disabled = false;
      btn.textContent = '生成';
    }
  }

  showEditCode(id) {
    fetch('/api/admin/redemption-codes')
      .then(r => r.json())
      .then(codes => {
        const code = codes.find(c => c.id === id);
        if (!code) return;
        document.getElementById('editCodeId').value = code.id;
        document.getElementById('editCodeValue').value = code.code;
        document.getElementById('editCodeAmount').value = parseFloat(code.amount);
        document.getElementById('editCodeMaxUses').value = code.max_uses;
        document.getElementById('editCodeExpiresAt').value = code.expires_at ? new Date(code.expires_at).toISOString().slice(0, 16) : '';
        document.getElementById('editCodeBatchName').value = code.batch_name || '';
        document.getElementById('editCodeRefundable').checked = code.refundable;
        document.getElementById('editCodeFeeRate').value = code.fee_rate || 0;
        document.getElementById('editCodeFeeRateGroup').style.display = code.refundable ? 'block' : 'none';
        document.getElementById('editCodeModal').style.display = 'flex';
        document.getElementById('editCodeModal').classList.add('active');
      });
  }

  async saveEditCode() {
    const id = document.getElementById('editCodeId').value;
    const amount = parseFloat(document.getElementById('editCodeAmount').value);
    const maxUses = parseInt(document.getElementById('editCodeMaxUses').value);
    const expiresAt = document.getElementById('editCodeExpiresAt').value || null;
    const batchName = document.getElementById('editCodeBatchName').value.trim() || null;
    const refundable = document.getElementById('editCodeRefundable').checked;
    const feeRate = parseFloat(document.getElementById('editCodeFeeRate').value) || 0;

    if (isNaN(amount) || amount <= 0) {
      alert('请输入有效的面额');
      return;
    }

    try {
      const response = await fetch(`/api/admin/redemption-codes/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount, maxUses, expiresAt, batchName, refundable, feeRate })
      });
      const result = await response.json();
      if (response.ok && result.success) {
        this.closeModals();
        this.loadRedemptionCodes();
      } else {
        alert(result.error || '保存失败');
      }
    } catch (error) {
      console.error('编辑兑换码失败:', error);
      alert('保存失败');
    }
  }

  async deleteRedemptionCode(id) {
    if (!confirm('确定要删除此兑换码吗？')) return;
    try {
      const response = await fetch(`/api/admin/redemption-codes/${id}`, { method: 'DELETE' });
      if (response.ok) {
        this.loadRedemptionCodes();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '删除失败');
      }
    } catch (error) {
      console.error('删除兑换码失败:', error);
      alert('删除失败');
    }
  }

  async batchDeleteRedemptionCodes() {
    const ids = [...(this.selectedCodes || [])];
    if (ids.length === 0) return;
    if (!confirm(`确定要删除选中的 ${ids.length} 个兑换码吗？`)) return;
    try {
      const response = await fetch('/api/admin/redemption-codes/batch-delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids })
      });
      if (response.ok) {
        this.loadRedemptionCodes();
      } else {
        const err = await response.json().catch(() => ({}));
        alert(err.error || '批量删除失败');
      }
    } catch (error) {
      console.error('批量删除兑换码失败:', error);
      alert('批量删除失败');
    }
  }

  // ========== DS2API 配置管理 ==========

  async loadDs2apiConfig() {
    try {
      const response = await fetch('/api/admin/ds2api-config');
      if (!response.ok) throw new Error('加载失败');
      const cfg = await response.json();

      document.getElementById('ds2apiBaseUrl').value = cfg.baseUrl || '';
      document.getElementById('ds2apiAdminKey').value = cfg.adminKey || '';
      document.getElementById('ds2apiEnabled').checked = cfg.enabled;

      // 显示/隐藏管理控制台加载卡片
      const consoleLoadCard = document.getElementById('ds2apiConsoleLoadCard');
      const consoleWrap = document.getElementById('ds2apiConsoleWrap');
      const consolePlaceholder = document.getElementById('ds2apiConsolePlaceholder');
      if (cfg.baseUrl && cfg.enabled) {
        if (consoleLoadCard) consoleLoadCard.style.display = 'block';
        if (consoleWrap) consoleWrap.style.display = 'none';
        if (consolePlaceholder) consolePlaceholder.style.display = 'none';
      } else {
        if (consoleLoadCard) consoleLoadCard.style.display = 'none';
        if (consoleWrap) consoleWrap.style.display = 'none';
        if (consolePlaceholder) consolePlaceholder.style.display = 'block';
      }
    } catch (error) {
      console.error('加载 ds2api 配置失败:', error);
    }
  }

  loadDs2apiConsole() {
    const consoleLoadCard = document.getElementById('ds2apiConsoleLoadCard');
    const consoleWrap = document.getElementById('ds2apiConsoleWrap');
    const consoleFrame = document.getElementById('ds2apiConsoleFrame');
    const baseUrl = document.getElementById('ds2apiBaseUrl').value.trim();
    if (!baseUrl) return;
    if (consoleLoadCard) consoleLoadCard.style.display = 'none';
    if (consoleWrap) consoleWrap.style.display = 'block';
    if (consoleFrame) consoleFrame.src = baseUrl.replace(/\/+$/, '') + '/admin';
  }

  async saveDs2apiConfig() {
    const btn = document.getElementById('saveDs2apiConfigBtn');
    const statusEl = document.getElementById('ds2apiConfigStatus');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '保存中...';
    }

    try {
      const response = await fetch('/api/admin/ds2api-config', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          baseUrl: document.getElementById('ds2apiBaseUrl').value.trim(),
          adminKey: document.getElementById('ds2apiAdminKey').value.trim(),
          enabled: document.getElementById('ds2apiEnabled').checked
        })
      });

      const result = await response.json();
      if (response.ok && result.success) {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '配置已保存!';
        setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
        // 更新侧边栏显示
        this.loadDs2apiConfig();
      } else {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '保存失败';
      }
    } catch (error) {
      console.error('保存 ds2api 配置失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '保存配置';
      }
    }
  }

  async testDs2apiConnection() {
    const btn = document.getElementById('testDs2apiBtn');
    const statusEl = document.getElementById('ds2apiConfigStatus');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '测试中...';
    }

    try {
      const response = await fetch('/api/admin/ds2api-config/test', { method: 'POST' });
      const result = await response.json();

      statusEl.style.display = 'block';
      if (result.success) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '连接成功! ds2api 服务正常运行。';
      } else {
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.message || '连接失败';
      }
    } catch (error) {
      console.error('测试 ds2api 连接失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>测试连接`;
      }
    }
  }

