  // ========== Z.ai2api 配置管理 ==========

  async loadZai2apiConfig() {
    try {
      const response = await fetch('/api/admin/zai2api-config');
      if (!response.ok) throw new Error('加载失败');
      const cfg = await response.json();

      document.getElementById('zai2apiBaseUrl').value = cfg.baseUrl || '';
      document.getElementById('zai2apiToken').value = cfg.token || '';
      document.getElementById('zai2apiEnabled').checked = cfg.enabled;

      // 显示/隐藏管理控制台
      const consoleWrap = document.getElementById('zai2apiConsoleWrap');
      const consolePlaceholder = document.getElementById('zai2apiConsolePlaceholder');
      if (cfg.baseUrl && cfg.enabled) {
        if (consoleWrap) consoleWrap.style.display = 'block';
        if (consolePlaceholder) consolePlaceholder.style.display = 'none';
        this.loadZai2apiSettings(cfg.baseUrl);
      } else {
        if (consoleWrap) consoleWrap.style.display = 'none';
        if (consolePlaceholder) consolePlaceholder.style.display = 'block';
      }
    } catch (error) {
      console.error('加载 zai2api 配置失败:', error);
    }
  }

  async loadZai2apiSettings(baseUrl) {
    try {
      const response = await fetch(baseUrl.replace(/\/+$/, '') + '/api/settings');
      if (!response.ok) throw new Error('加载失败');
      const data = await response.json();
      if (!data.success) throw new Error(data.error || '加载失败');

      const s = data.settings;
      document.getElementById('zaiModelDefault').value = s.model?.default || '';
      document.getElementById('zaiApiThink').value = s.api?.think || 'reasoning';
      document.getElementById('zaiApiPort').value = s.api?.port || '';
      document.getElementById('zaiSecurityRateLimit').value = s.security?.rate_limit || 0;
      document.getElementById('zaiSecurityMaxTokens').value = s.security?.max_tokens || 0;
      document.getElementById('zaiLoggingLevel').value = s.logging?.level || 'INFO';
      document.getElementById('zaiModelMapping').value = s.model?.mapping ? JSON.stringify(s.model.mapping, null, 2) : '';
      document.getElementById('zaiSecurityApiKey').value = '';
      document.getElementById('zaiSecurityAllowedOrigins').value = s.security?.allowed_origins ? JSON.stringify(s.security.allowed_origins) : '["*"]';
    } catch (error) {
      console.error('加载 zai2api 设置失败:', error);
    }
  }

  async saveZai2apiSettings() {
    const baseUrl = document.getElementById('zai2apiBaseUrl').value.trim();
    if (!baseUrl) return;

    const statusEl = document.getElementById('zai2apiSettingsStatus');
    let mapping = {};
    try {
      const mappingVal = document.getElementById('zaiModelMapping').value.trim();
      if (mappingVal) mapping = JSON.parse(mappingVal);
    } catch (e) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '模型映射 JSON 格式错误';
      setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
      return;
    }

    let allowedOrigins = ['*'];
    try {
      const originsVal = document.getElementById('zaiSecurityAllowedOrigins').value.trim();
      if (originsVal) allowedOrigins = JSON.parse(originsVal);
    } catch (e) {}

    const body = {
      model: {
        default: document.getElementById('zaiModelDefault').value.trim(),
        mapping
      },
      api: {
        think: document.getElementById('zaiApiThink').value,
        port: parseInt(document.getElementById('zaiApiPort').value) || 8080
      },
      security: {
        rate_limit: parseInt(document.getElementById('zaiSecurityRateLimit').value) || 0,
        max_tokens: parseInt(document.getElementById('zaiSecurityMaxTokens').value) || 0,
        allowed_origins
      },
      logging: {
        level: document.getElementById('zaiLoggingLevel').value
      }
    };

    const apiKey = document.getElementById('zaiSecurityApiKey').value;
    if (apiKey) body.security.api_key = apiKey;

    try {
      const response = await fetch(baseUrl.replace(/\/+$/, '') + '/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const result = await response.json();
      if (result.success) {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '设置已保存!';
        setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
        this.loadZai2apiSettings(baseUrl);
      } else {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = (result.errors || [result.error]).join('; ') || '保存失败';
      }
    } catch (error) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    }
  }

  async resetZai2apiSettings() {
    const baseUrl = document.getElementById('zai2apiBaseUrl').value.trim();
    if (!baseUrl) return;
    if (!confirm('确定要重置所有设置为默认值吗？')) return;

    const statusEl = document.getElementById('zai2apiSettingsStatus');
    try {
      const response = await fetch(baseUrl.replace(/\/+$/, '') + '/api/settings/reset', { method: 'POST' });
      const result = await response.json();
      if (result.success) {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '已重置为默认设置!';
        setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
        this.loadZai2apiSettings(baseUrl);
      } else {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '重置失败';
      }
    } catch (error) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    }
  }

