      statusEl.textContent = '网络错误: ' + error.message;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>测试连接`;
      }
    }
  }

  // ========== Z.ai2API 账号管理 ==========

  switchZai2apiTab(tab) {
    document.querySelectorAll('.zai2api-tab').forEach(t => {
      t.classList.remove('active');
      t.style.color = 'var(--muted-foreground)';
      t.style.borderBottom = '2px solid transparent';
    });
    document.querySelectorAll('.zai2api-tab-content').forEach(c => {
      c.style.display = 'none';
    });
    event.target.classList.add('active');
    event.target.style.color = 'var(--foreground)';
    event.target.style.borderBottom = '2px solid #3b82f6';
    document.getElementById(`zai2apiTab${tab.charAt(0).toUpperCase() + tab.slice(1)}`).style.display = 'block';
    if (tab === 'accounts') this.loadZai2apiAccounts();
    if (tab === 'stats') this.loadZai2apiStats();
    if (tab === 'config') this.loadZai2apiConfigSettings();
  }

  async loadZai2apiAccounts() {
    try {
      const response = await fetch('/api/admin/zai2api-accounts');
      if (!response.ok) throw new Error('加载失败');
      const data = await response.json();
      const accounts = data.accounts || [];
      this.zai2apiAccountsData = accounts;
      this.renderZai2apiAccounts(accounts);
    } catch (error) {
      console.error('加载 zai2api 账号列表失败:', error);
    }
  }

  renderZai2apiAccounts(accounts) {
    const container = document.getElementById('zai2apiAccountsList');
    const countEl = document.getElementById('zai2apiAccountCount');
    if (countEl) countEl.textContent = `共 ${accounts.length} 个账号`;
    
    if (accounts.length === 0) {
      container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无账号</p>';
      return;
    }
    container.innerHTML = `
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>用户名</th>
            <th>标签</th>
            <th>状态</th>
            <th>启用</th>
            <th>请求数</th>
            <th>成功率</th>
            <th>最后使用</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          ${accounts.map(acc => `
            <tr>
              <td style="font-family:monospace;font-size:12px;">${acc.id?.substring(0, 8) || '-'}</td>
              <td>${acc.user_name || '-'}</td>
              <td>${acc.label || '-'}</td>
              <td>${this.getZai2apiStatusBadge(acc.status)}</td>
              <td>${acc.is_active ? '<span style="color:#10b981">是</span>' : '<span style="color:var(--destructive)">否</span>'}</td>
              <td>${acc.total_requests || 0}</td>
              <td>${acc.total_requests > 0 ? ((acc.success_count / acc.total_requests) * 100).toFixed(1) + '%' : '-'}</td>
              <td>${acc.last_used ? new Date(acc.last_used).toLocaleString('zh-CN') : '-'}</td>
              <td>
                <button class="btn btn-sm btn-secondary" onclick="adminApp.viewZai2apiAccountDetail('${acc.id}')" title="详情">详情</button>
                <button class="btn btn-sm btn-secondary" onclick="adminApp.editZai2apiAccount('${acc.id}')" title="编辑">编辑</button>
                <button class="btn btn-sm btn-secondary" onclick="adminApp.toggleZai2apiAccount('${acc.id}')" title="切换状态">${acc.is_active ? '禁用' : '启用'}</button>
                <button class="btn btn-sm btn-danger" onclick="adminApp.deleteZai2apiAccount('${acc.id}')" title="删除">删除</button>
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  getZai2apiStatusBadge(status) {
    const colors = {
      'healthy': '#10b981',
      'unhealthy': '#ef4444',
      'disabled': '#6b7280'
    };
    const labels = {
      'healthy': '健康',
      'unhealthy': '不健康',
      'disabled': '已禁用'
    };
    return `<span style="color:${colors[status] || '#6b7280'}">${labels[status] || status}</span>`;
  }

  filterZai2apiAccounts() {
    const search = (document.getElementById('zai2apiAccountSearch')?.value || '').toLowerCase();
    const status = document.getElementById('zai2apiAccountStatusFilter')?.value || '';
    const active = document.getElementById('zai2apiAccountActiveFilter')?.value || '';
    
    let filtered = this.zai2apiAccountsData || [];
    if (search) {
      filtered = filtered.filter(acc => 
        (acc.user_name || '').toLowerCase().includes(search) ||
        (acc.label || '').toLowerCase().includes(search)
      );
    }
    if (status) {
      filtered = filtered.filter(acc => acc.status === status);
    }
    if (active) {
      filtered = filtered.filter(acc => acc.is_active === (active === 'true'));
    }
    this.renderZai2apiAccounts(filtered);
  }

  showAddZai2apiAccountModal() {
    document.getElementById('zai2apiAccountId').value = '';
    document.getElementById('zai2apiAccountCookie').value = '';
    document.getElementById('zai2apiAccountLabel').value = '';
    document.getElementById('zai2apiAccountAutoEnable').checked = true;
    document.getElementById('zai2apiAccountModal').style.display = 'flex';
    document.getElementById('zai2apiAccountModal').classList.add('active');
  }

  closeZai2apiAccountModal() {
    document.getElementById('zai2apiAccountModal').style.display = 'none';
    document.getElementById('zai2apiAccountModal').classList.remove('active');
  }

  async saveZai2apiAccount() {
    const cookie = document.getElementById('zai2apiAccountCookie').value.trim();
    const label = document.getElementById('zai2apiAccountLabel').value.trim();
    const auto_enable = document.getElementById('zai2apiAccountAutoEnable').checked;
    
    if (!cookie) {
      alert('请输入 Cookie');
      return;
    }
    
    try {
      const response = await fetch('/api/admin/zai2api-accounts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cookie, label, auto_enable })
      });
      const result = await response.json();
      if (result.success) {
        this.closeZai2apiAccountModal();
        this.loadZai2apiAccounts();
      } else {
        alert(result.error || '添加失败');
      }
    } catch (error) {
      console.error('添加 zai2api 账号失败:', error);
      alert('添加失败');
    }
  }

  async editZai2apiAccount(id) {
    try {
      const response = await fetch(`/api/admin/zai2api-accounts/${id}`);
      const data = await response.json();
      if (!data.success) throw new Error(data.error || '加载失败');
      const acc = data.account;
      
      document.getElementById('zai2apiEditAccountId').value = acc.id;
      document.getElementById('zai2apiEditAccountLabel').value = acc.label || '';
      document.getElementById('zai2apiEditAccountCookie').value = '';
      document.getElementById('zai2apiEditAccountPriority').value = acc.priority || 10;
      document.getElementById('zai2apiEditAccountExpiresAt').value = acc.expires_at ? new Date(acc.expires_at).toISOString().slice(0, 16) : '';
      
      document.getElementById('zai2apiEditAccountModal').style.display = 'flex';
      document.getElementById('zai2apiEditAccountModal').classList.add('active');
    } catch (error) {
      console.error('加载 zai2api 账号详情失败:', error);
      alert('加载失败');
    }
  }

  closeZai2apiEditAccountModal() {
    document.getElementById('zai2apiEditAccountModal').style.display = 'none';
    document.getElementById('zai2apiEditAccountModal').classList.remove('active');
  }

  async updateZai2apiAccount() {
    const id = document.getElementById('zai2apiEditAccountId').value;
    const data = {
      label: document.getElementById('zai2apiEditAccountLabel').value.trim(),
      priority: parseInt(document.getElementById('zai2apiEditAccountPriority').value) || 10
    };
    const cookie = document.getElementById('zai2apiEditAccountCookie').value.trim();
    if (cookie) data.cookie = cookie;
    const expiresAt = document.getElementById('zai2apiEditAccountExpiresAt').value;
    if (expiresAt) data.expires_at = new Date(expiresAt).toISOString();
    
    try {
      const response = await fetch(`/api/admin/zai2api-accounts/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        this.closeZai2apiEditAccountModal();
        this.loadZai2apiAccounts();
      } else {
        alert(result.error || '更新失败');
      }
    } catch (error) {
      console.error('更新 zai2api 账号失败:', error);
      alert('更新失败');
    }
  }

  async deleteZai2apiAccount(id) {
    if (!confirm('确定要删除此账号吗？')) return;
    try {
      const response = await fetch(`/api/admin/zai2api-accounts/${id}`, { method: 'DELETE' });
      const result = await response.json();
      if (result.success) {
        this.loadZai2apiAccounts();
      } else {
        alert(result.error || '删除失败');
      }
    } catch (error) {
      console.error('删除 zai2api 账号失败:', error);
      alert('删除失败');
    }
  }

  async toggleZai2apiAccount(id) {
    try {
      const response = await fetch(`/api/admin/zai2api-accounts/${id}/toggle`, { method: 'POST' });
      const result = await response.json();
      if (result.success) {
        this.loadZai2apiAccounts();
      } else {
        alert(result.error || '操作失败');
      }
    } catch (error) {
      console.error('切换 zai2api 账号状态失败:', error);
      alert('操作失败');
    }
  }

  async viewZai2apiAccountDetail(id) {
    try {
      const response = await fetch(`/api/admin/zai2api-accounts/${id}/details`);
      const data = await response.json();
      if (!data.success) throw new Error(data.error || '加载失败');
      const acc = data.account;
      
      const content = document.getElementById('zai2apiAccountDetailContent');
      content.innerHTML = `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">ID</div>
            <div style="font-weight:500;font-family:monospace;">${acc.id}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">用户名</div>
            <div style="font-weight:500;">${acc.user_name || '-'}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">标签</div>
            <div style="font-weight:500;">${acc.label || '-'}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">状态</div>
            <div style="font-weight:500;">${this.getZai2apiStatusBadge(acc.status)}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">优先级</div>
            <div style="font-weight:500;">${acc.priority || 10}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">总请求数</div>
            <div style="font-weight:500;">${acc.total_requests || 0}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">成功率</div>
            <div style="font-weight:500;">${acc.total_requests > 0 ? ((acc.success_count / acc.total_requests) * 100).toFixed(1) + '%' : '-'}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">平均响应时间</div>
            <div style="font-weight:500;">${acc.avg_response_time ? acc.avg_response_time.toFixed(2) + 's' : '-'}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">添加时间</div>
            <div style="font-weight:500;">${acc.added_at ? new Date(acc.added_at).toLocaleString('zh-CN') : '-'}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;">
            <div style="font-size:12px;color:var(--muted-foreground);">最后使用</div>
            <div style="font-weight:500;">${acc.last_used ? new Date(acc.last_used).toLocaleString('zh-CN') : '-'}</div>
          </div>
          <div style="background:var(--muted);padding:12px;border-radius:8px;grid-column:span 2;">
            <div style="font-size:12px;color:var(--muted-foreground);">有效期</div>
            <div style="font-weight:500;">${acc.expires_at ? new Date(acc.expires_at).toLocaleString('zh-CN') : '永不过期'}</div>
          </div>
        </div>
      `;
      document.getElementById('zai2apiAccountDetailModal').style.display = 'flex';
      document.getElementById('zai2apiAccountDetailModal').classList.add('active');
    } catch (error) {
      console.error('加载 zai2api 账号详情失败:', error);
    }
  }

  closeZai2apiAccountDetailModal() {
    document.getElementById('zai2apiAccountDetailModal').style.display = 'none';
    document.getElementById('zai2apiAccountDetailModal').classList.remove('active');
  }

  async healthCheckZai2apiAccounts() {
    if (!confirm('确定要对所有账号进行健康检查吗？')) return;
    try {
      const response = await fetch('/api/admin/zai2api-accounts/health', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      const result = await response.json();
      if (result.success) {
        alert(`健康检查完成！结果: ${JSON.stringify(result.results?.length || 0)} 个账号`);
        this.loadZai2apiAccounts();
      } else {
        alert(result.error || '健康检查失败');
      }
    } catch (error) {
      console.error('zai2api 健康检查失败:', error);
      alert('健康检查失败');
    }
  }

  showBatchImportZai2apiModal() {
    document.getElementById('zai2apiBatchImportCookies').value = '';
    document.getElementById('zai2apiBatchImportLabel').value = '批量导入';
    document.getElementById('zai2apiBatchImportStatus').style.display = 'none';
    document.getElementById('zai2apiBatchImportModal').style.display = 'flex';
    document.getElementById('zai2apiBatchImportModal').classList.add('active');
  }

  closeZai2apiBatchImportModal() {
    document.getElementById('zai2apiBatchImportModal').style.display = 'none';
    document.getElementById('zai2apiBatchImportModal').classList.remove('active');
  }

  async executeZai2apiBatchImport() {
    const cookiesText = document.getElementById('zai2apiBatchImportCookies').value.trim();
    const label = document.getElementById('zai2apiBatchImportLabel').value.trim();
    const statusEl = document.getElementById('zai2apiBatchImportStatus');
    const btn = document.getElementById('zai2apiBatchImportBtn');
    
    if (!cookiesText) {
      alert('请输入 Cookie 列表');
      return;
    }
    
    const cookies = cookiesText.split('\n').map(c => c.trim()).filter(c => c);
    
    btn.disabled = true;
    btn.textContent = '导入中...';
    
    try {
      const response = await fetch('/api/admin/zai2api-accounts/batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cookies, label })
      });
      const result = await response.json();
      
      statusEl.style.display = 'block';
      if (result.success) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = `导入完成！成功: ${result.results?.success || 0}, 失败: ${result.results?.failed || 0}`;
        this.loadZai2apiAccounts();
      } else {
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '导入失败';
      }
    } catch (error) {
      console.error('批量导入 zai2api 账号失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
    } finally {
      btn.disabled = false;
      btn.textContent = '导入';
    }
  }

  async exportZai2apiAccounts() {
    try {
      const response = await fetch('/api/admin/zai2api-accounts/export');
      const result = await response.json();
      if (result.success) {
        const dataStr = JSON.stringify(result, null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `zai2api-accounts-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
      } else {
        alert(result.error || '导出失败');
      }
    } catch (error) {
      console.error('导出 zai2api 账号失败:', error);
      alert('导出失败');
    }
  }

  async loadZai2apiStats() {
    try {
      const response = await fetch('/api/admin/zai2api-stats');
      const data = await response.json();
      if (data.success) {
        const stats = data.stats;
        document.getElementById('zai2apiStatsTotalAccounts').textContent = stats.total_accounts || 0;
        document.getElementById('zai2apiStatsActiveAccounts').textContent = stats.active_accounts || 0;
        document.getElementById('zai2apiStatsTotalRequests').textContent = stats.total_requests || 0;
        document.getElementById('zai2apiStatsErrorRate').textContent = stats.error_rate ? stats.error_rate.toFixed(2) + '%' : '0%';
      }
    } catch (error) {
      console.error('加载 zai2api 统计失败:', error);
    }
  }

  async resetZai2apiStats() {
    if (!confirm('确定要重置所有统计信息吗？')) return;
    try {
      const response = await fetch('/api/admin/zai2api-stats/reset', { method: 'POST' });
      const result = await response.json();
      if (result.success) {
        this.loadZai2apiStats();
      } else {
        alert(result.error || '重置失败');
      }
    } catch (error) {
      console.error('重置 zai2api 统计失败:', error);
      alert('重置失败');
    }
  }

  async loadZai2apiConfigSettings() {
    try {
      const response = await fetch('/api/admin/zai2api-config-settings');
      const data = await response.json();
      if (data.success) {
        const config = data.config;
        document.getElementById('zai2apiConfigMode').value = config.mode || 'round-robin';
        document.getElementById('zai2apiConfigMaxRetries').value = config.max_retries || 3;
        document.getElementById('zai2apiConfigHealthCheckInterval').value = config.health_check_interval || 300;
        document.getElementById('zai2apiConfigAutoDisableThreshold').value = config.auto_disable_threshold || 5;
        document.getElementById('zai2apiConfigCooldownPeriod').value = config.cooldown_period || 60;
        document.getElementById('zai2apiConfigMaxConcurrent').value = config.max_concurrent || 0;
        document.getElementById('zai2apiConfigRetryFailed').checked = config.retry_failed !== false;
        document.getElementById('zai2apiConfigTokenRefresh').checked = config.token_refresh !== false;
      }
    } catch (error) {
      console.error('加载 zai2api 配置失败:', error);
    }
  }

  async saveZai2apiConfigSettings() {
    const statusEl = document.getElementById('zai2apiConfigSettingsStatus');
    try {
      const config = {
        mode: document.getElementById('zai2apiConfigMode').value,
        max_retries: parseInt(document.getElementById('zai2apiConfigMaxRetries').value) || 3,
        health_check_interval: parseInt(document.getElementById('zai2apiConfigHealthCheckInterval').value) || 300,
        auto_disable_threshold: parseInt(document.getElementById('zai2apiConfigAutoDisableThreshold').value) || 5,
        cooldown_period: parseInt(document.getElementById('zai2apiConfigCooldownPeriod').value) || 60,
        max_concurrent: parseInt(document.getElementById('zai2apiConfigMaxConcurrent').value) || 0,
        retry_failed: document.getElementById('zai2apiConfigRetryFailed').checked,
        token_refresh: document.getElementById('zai2apiConfigTokenRefresh').checked
      };
      
      const response = await fetch('/api/admin/zai2api-config-settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(config)
      });
      const result = await response.json();
      
      statusEl.style.display = 'block';
      if (result.success) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '配置已保存!';
        setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
      } else {
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '保存失败';
      }
    } catch (error) {
      console.error('保存 zai2api 配置失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
    }
  }

  // ========== Kimi2API 配置管理 ==========

  async loadKimi2apiConfig() {
    try {
      const response = await fetch('/api/admin/kimi2api-config');
      if (!response.ok) throw new Error('加载失败');
      const cfg = await response.json();

      document.getElementById('kimi2apiBaseUrl').value = cfg.baseUrl || '';
      document.getElementById('kimi2apiToken').value = cfg.token || '';
      document.getElementById('kimi2apiEnabled').checked = cfg.enabled;
    } catch (error) {
      console.error('加载 kimi2api 配置失败:', error);
    }
  }

  async saveKimi2apiConfig() {
    const btn = document.getElementById('saveKimi2apiConfigBtn');
    const statusEl = document.getElementById('kimi2apiConfigStatus');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '保存中...';
    }

    try {
      const response = await fetch('/api/admin/kimi2api-config', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          baseUrl: document.getElementById('kimi2apiBaseUrl').value.trim(),
          token: document.getElementById('kimi2apiToken').value.trim(),
          enabled: document.getElementById('kimi2apiEnabled').checked
        })
      });

      const result = await response.json();
      if (response.ok && result.success) {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '配置已保存!';
        setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
      } else {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '保存失败';
      }
    } catch (error) {
      console.error('保存 kimi2api 配置失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '保存配置';
      }
    }
  }

  async testKimi2apiConnection() {
    const btn = document.getElementById('testKimi2apiBtn');
    const statusEl = document.getElementById('kimi2apiConfigStatus');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '测试中...';
    }

    try {
      const response = await fetch('/api/admin/kimi2api-config/test', { method: 'POST' });
      const result = await response.json();

      statusEl.style.display = 'block';
      if (result.success) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '连接成功! kimi2api 服务正常运行。';
      } else {
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.message || '连接失败';
      }
    } catch (error) {
      console.error('测试 kimi2api 连接失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>测试连接`;
      }
    }
  }

  // ========== OpenAI Codex 配置管理 ==========

  async loadCodexStatus() {
    try {
      const response = await fetch('/api/admin/providers/codex/status');
      if (!response.ok) throw new Error('加载失败');
      const status = await response.json();

      const statusInfo = document.getElementById('codexStatusInfo');
      if (status.hasAccessToken) {
        statusInfo.style.display = 'block';
        document.getElementById('codexLoginStatus').textContent = status.isLoggedIn ? '已登录' : '未登录';
        document.getElementById('codexLoginStatus').style.color = status.isLoggedIn ? '#10b981' : 'var(--destructive)';
        document.getElementById('codexAccountId').textContent = status.accountId || '-';
        document.getElementById('codexExpiresAt').textContent = status.expiresAt ? new Date(status.expiresAt).toLocaleString() : '-';
        document.getElementById('codexAccessToken').textContent = status.accessTokenPreview || '-';
        document.getElementById('codexRefreshToken').textContent = status.hasRefreshToken ? '已配置' : '未配置';
      } else {
        statusInfo.style.display = 'none';
      }
    } catch (error) {
      console.error('加载 Codex 状态失败:', error);
    }
  }

  showImportCodexModal() {
    document.getElementById('importCodexModal').style.display = 'flex';
    document.getElementById('importCodexModal').classList.add('active');
    document.getElementById('codexConfigJson').value = '';
    document.getElementById('importCodexStatus').style.display = 'none';
  }

  closeImportCodexModal() {
    document.getElementById('importCodexModal').style.display = 'none';
    document.getElementById('importCodexModal').classList.remove('active');
  }

  async importCodexConfig() {
    const jsonInput = document.getElementById('codexConfigJson').value.trim();
    const statusEl = document.getElementById('importCodexStatus');
    const btn = document.getElementById('confirmImportCodexBtn');

    if (!jsonInput) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '请粘贴 Codex 配置 JSON';
      return;
    }

    let config;
    try {
      config = JSON.parse(jsonInput);
    } catch (e) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = 'JSON 格式错误: ' + e.message;
      return;
    }

    if (!config.tokens || !config.tokens.access_token) {
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '缺少 tokens.access_token 字段';
      return;
    }

    if (btn) {
      btn.disabled = true;
      btn.textContent = '导入中...';
    }

    try {
      const response = await fetch('/api/admin/providers/codex/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(config)
      });

      const result = await response.json();
      if (response.ok && result.success) {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = `导入成功! 账号 ID: ${result.accountId || 'N/A'}`;
        setTimeout(() => {
          this.closeImportCodexModal();
          this.loadCodexStatus();
          this.loadProviders();
        }, 2000);
      } else {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '导入失败';
      }
    } catch (error) {
      console.error('导入 Codex 配置失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '导入';
      }
    }
  }

  async refreshCodexToken() {
    const btn = document.getElementById('refreshCodexTokenBtn');
    const statusEl = document.getElementById('codexConfigStatus');

    if (btn) {
      btn.disabled = true;
      btn.textContent = '刷新中...';
    }

    try {
      const response = await fetch('/api/admin/providers/codex/refresh', { method: 'POST' });
      const result = await response.json();

      statusEl.style.display = 'block';
      if (response.ok && result.success) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '令牌刷新成功!';
        this.loadCodexStatus();
      } else {
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '刷新失败';
      }
    } catch (error) {
      console.error('刷新 Codex 令牌失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>刷新令牌`;
      }
    }
  }

  async checkCodexStatus() {
    const btn = document.getElementById('checkCodexStatusBtn');
    const statusEl = document.getElementById('codexConfigStatus');

    if (btn) {
      btn.disabled = true;
      btn.textContent = '检查中...';
    }

    try {
      const response = await fetch('/api/admin/providers/codex/status');
      const result = await response.json();

      statusEl.style.display = 'block';
      if (result.isLoggedIn) {
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = `已登录! 账号 ID: ${result.accountId || 'N/A'}, 令牌过期: ${result.expiresAt ? new Date(result.expiresAt).toLocaleString() : 'N/A'}`;
      } else {
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = '未登录，请先导入 Codex 配置';
      }
      this.loadCodexStatus();
    } catch (error) {
      console.error('检查 Codex 状态失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误: ' + error.message;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>检查状态`;
      }
    }
  }

  closeModals() {
    document.querySelectorAll('.modal').forEach(modal => {
      modal.style.display = 'none';
      modal.classList.remove('active');
    });
    document.getElementById('modelId').disabled = false;
  }

  // ========== 商品管理 ==========

  async loadProducts() {
    try {
      const response = await fetch('/api/admin/products');
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '加载失败');
      }
      this.allProducts = await response.json();
      this.selectedProducts = new Set();
      this.renderProducts();
    } catch (error) {
      console.error('加载商品列表失败:', error);
      document.getElementById('productsList').innerHTML = `<p style="text-align:center;color:var(--destructive);padding:20px;">${error.message || '加载商品列表失败'}</p>`;
    }
  }

  renderProducts() {
    const container = document.getElementById('productsList');
    const products = this.allProducts || [];

    if (products.length === 0) {
      container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:40px;">暂无商品，点击"添加商品"创建</p>';
      return;
    }

    container.innerHTML = `
      <table>
        <thead>
          <tr>
            <th style="width:40px;"><input type="checkbox" class="checkbox" onchange="adminApp.toggleSelectAllProducts(this.checked)"></th>
            <th>商品名称</th>
            <th>描述</th>
            <th>链接</th>
            <th>状态</th>
            <th>排序</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          ${products.map(p => `
            <tr>
              <td><input type="checkbox" class="checkbox" value="${p.id}" onchange="adminApp.toggleProductSelection(${p.id}, this.checked)"></td>
              <td style="font-weight:500;">${p.name}</td>
              <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted-foreground);font-size:13px;">${p.description || '-'}</td>
              <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;">${p.link ? `<a href="${p.link}" target="_blank" style="color:var(--brand-blue);">${p.link}</a>` : '-'}</td>
              <td>${p.is_active ? '<span style="color:#10b981;">上架</span>' : '<span style="color:var(--muted-foreground);">下架</span>'}</td>
              <td>${p.sort_order}</td>
              <td style="font-size:12px;color:var(--muted-foreground);">${new Date(p.created_at).toLocaleDateString('zh-CN')}</td>
              <td>
                <button class="btn btn-sm btn-secondary" onclick="adminApp.editProduct(${p.id})" style="margin-right:6px;">编辑</button>
                <button class="btn btn-sm btn-danger" onclick="adminApp.deleteProduct(${p.id})">删除</button>
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  toggleSelectAllProducts(checked) {
    const checkboxes = document.querySelectorAll('#productsList input[type="checkbox"]');
    checkboxes.forEach(cb => {
      if (cb.closest('thead')) return;
      cb.checked = checked;
    });
    this.updateSelectedProducts();
  }

  toggleProductSelection(id, checked) {
    this.updateSelectedProducts();
  }

  updateSelectedProducts() {
    const checkboxes = document.querySelectorAll('#productsList tbody input[type="checkbox"]');
    const count = [...checkboxes].filter(cb => cb.checked).length;
    const btn = document.getElementById('batchDeleteProductsBtn');
    if (btn) btn.style.display = count > 0 ? 'inline-block' : 'none';
  }

  showProductModal(product) {
    const modal = document.getElementById('productModal');
    document.getElementById('productModalTitle').textContent = product ? '编辑商品' : '添加商品';
    document.getElementById('editProductId').value = product ? product.id : '';
    document.getElementById('editProductName').value = product ? product.name : '';
    document.getElementById('editProductDescription').value = product ? (product.description || '') : '';
    document.getElementById('editProductImageUrl').value = product ? (product.image_url || '') : '';
    document.getElementById('editProductLink').value = product ? (product.link || '') : '';
    document.getElementById('editProductSortOrder').value = product ? (product.sort_order || 0) : 0;
    document.getElementById('editProductActive').checked = product ? product.is_active : true;
    modal.style.display = 'flex';
  }

  closeProductModal() {
    document.getElementById('productModal').style.display = 'none';
  }

  editProduct(id) {
    const product = (this.allProducts || []).find(p => p.id === id);
    if (product) this.showProductModal(product);
  }

  async saveProduct() {
    const id = document.getElementById('editProductId').value;
    const name = document.getElementById('editProductName').value.trim();
    const description = document.getElementById('editProductDescription').value.trim();
    const image_url = document.getElementById('editProductImageUrl').value.trim() || null;
    const link = document.getElementById('editProductLink').value.trim() || null;
    const sort_order = parseInt(document.getElementById('editProductSortOrder').value) || 0;
    const is_active = document.getElementById('editProductActive').checked;

    if (!name) {
      alert('商品名称不能为空');
      return;
    }

    const body = { name, description, image_url, link, sort_order, is_active };

    try {
      const url = id ? `/api/admin/products/${id}` : '/api/admin/products';
      const method = id ? 'PUT' : 'POST';
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || '保存失败');
      this.closeProductModal();
      await this.loadProducts();
    } catch (error) {
      alert('保存商品失败: ' + error.message);
    }
  }

  async deleteProduct(id) {
    if (!confirm('确定要删除该商品吗？')) return;
    try {
      const response = await fetch(`/api/admin/products/${id}`, { method: 'DELETE' });
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || '删除失败');
      }
      await this.loadProducts();
    } catch (error) {
      alert('删除商品失败: ' + error.message);
    }
  }

  async batchDeleteProducts() {
    const checkboxes = document.querySelectorAll('#productsList tbody input[type="checkbox"]:checked');
    const ids = [...checkboxes].map(cb => parseInt(cb.value));
    if (ids.length === 0) {
      alert('请选择要删除的商品');
      return;
    }
    if (!confirm(`确定要删除 ${ids.length} 个商品吗？`)) return;
    try {
      const response = await fetch('/api/admin/products/batch-delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids })
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || '批量删除失败');
      await this.loadProducts();
    } catch (error) {
      alert('批量删除商品失败: ' + error.message);
    }
  }

  async logout() {
    try {
      await fetch('/auth/logout');
      window.location.href = '/';
    } catch (error) {
      console.error('登出失败:', error);
      window.location.href = '/';
    }
  }

  // ========== Kimi2API 页面管理 ==========

  async loadKimi2apiPage() {
    await this.loadKimi2apiConfig2();
    await this.loadKimi2apiHealth();
    await this.loadKimi2apiAccounts();
  }

  async loadKimi2apiConfig2() {
    try {
      const response = await fetch('/api/admin/kimi2api-config');
      if (!response.ok) throw new Error('加载失败');
      const cfg = await response.json();
      document.getElementById('kimi2apiBaseUrl2').value = cfg.baseUrl || '';
      document.getElementById('kimi2apiToken2').value = cfg.token || '';
      document.getElementById('kimi2apiEnabled2').checked = cfg.enabled;
    } catch (error) {
      console.error('加载 kimi2api 配置失败:', error);
    }
  }

  async saveKimi2apiConfig() {
    const btn = document.getElementById('saveKimi2apiConfigBtn2');
    const statusEl = document.getElementById('kimi2apiConfigStatus2');
    if (btn) {
      btn.disabled = true;
      btn.textContent = '保存中...';
    }
    try {
      const response = await fetch('/api/admin/kimi2api-config', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          baseUrl: document.getElementById('kimi2apiBaseUrl2').value.trim(),
          token: document.getElementById('kimi2apiToken2').value.trim(),
          enabled: document.getElementById('kimi2apiEnabled2').checked
        })
      });
      const result = await response.json();
      if (response.ok && result.success) {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#10b981';
        statusEl.textContent = '配置已保存!';
        setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
      } else {
        statusEl.style.display = 'block';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = 'var(--destructive)';
        statusEl.textContent = result.error || '保存失败';
      }
    } catch (error) {
      console.error('保存 kimi2api 配置失败:', error);
      statusEl.style.display = 'block';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = 'var(--destructive)';
      statusEl.textContent = '网络错误';
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '保存配置';
      }
    }
  }

  async loadKimi2apiHealth() {
    try {
      const response = await fetch('/api/admin/kimi2api-health');
      if (!response.ok) throw new Error('加载失败');
      const data = await response.json();
      document.getElementById('kimi2apiHealthStatusValue').textContent = data.status || '-';
      document.getElementById('kimi2apiHealthDb').textContent = data.database || '-';
      document.getElementById('kimi2apiHealthAccounts').textContent = data.accounts_count || '-';
      document.getElementById('kimi2apiHealthUsers').textContent = data.users_count || '-';
      document.getElementById('kimi2apiHealthVersion').textContent = data.version || '-';
    } catch (error) {
      console.error('加载 kimi2api 健康状态失败:', error);
    }
  }

  switchKimi2apiTab(tab) {
    document.querySelectorAll('.kimi2api-tab').forEach(t => {
      t.classList.remove('active');
      t.style.color = 'var(--muted-foreground)';
      t.style.borderBottom = '2px solid transparent';
    });
    document.querySelectorAll('.kimi2api-tab-content').forEach(c => {
      c.style.display = 'none';
    });
    event.target.classList.add('active');
    event.target.style.color = 'var(--foreground)';
    event.target.style.borderBottom = '2px solid #3b82f6';
    document.getElementById(`kimi2apiTab${tab.charAt(0).toUpperCase() + tab.slice(1)}`).style.display = 'block';
    if (tab === 'accounts') this.loadKimi2apiAccounts();
    if (tab === 'users') this.loadKimi2apiUsers();
    if (tab === 'stats') this.loadKimi2apiStats();
    if (tab === 'config') this.loadKimi2apiConfigSettings();
  }

  async loadKimi2apiAccounts() {
    try {
      const response = await fetch('/api/admin/kimi2api-accounts');
      if (!response.ok) throw new Error('加载失败');
      const data = await response.json();
      const accounts = data.accounts || [];
      const container = document.getElementById('kimi2apiAccountsList');
      if (accounts.length === 0) {
        container.innerHTML = '<p style="text-align:center;color:var(--muted-foreground);padding:20px;">暂无账号</p>';
        return;
      }
      container.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>名称</th>
              <th>描述</th>
              <th>优先级</th>
              <th>状态</th>
              <th>请求数</th>
              <th>最后使用</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${accounts.map(acc => `
              <tr>
                <td style="font-family:monospace;font-size:12px;">${acc.id}</td>
                <td>${acc.name || '-'}</td>
                <td>${acc.description || '-'}</td>
                <td>${acc.priority || 1}</td>
                <td>${acc.enabled ? '<span style="color:#10b981">启用</span>' : '<span style="color:var(--destructive)">禁用</span>'}</td>
                <td>${acc.request_count || 0}</td>
                <td>${acc.last_used ? new Date(acc.last_used).toLocaleString('zh-CN') : '-'}</td>
                <td>
                  <button class="btn btn-sm btn-secondary" onclick="adminApp.editKimi2apiAccount(${JSON.stringify(acc).replace(/"/g, '&quot;')})">编辑</button>
                  <button class="btn btn-sm btn-secondary" onclick="adminApp.viewKimi2apiAccountStats('${acc.id}')">统计</button>
                  <button class="btn btn-sm ${acc.enabled ? 'btn-danger' : 'btn-secondary'}" onclick="adminApp.toggleKimi2apiAccount('${acc.id}', ${!acc.enabled})">${acc.enabled ? '禁用' : '启用'}</button>
                  <button class="btn btn-sm btn-danger" onclick="adminApp.deleteKimi2apiAccount('${acc.id}')">删除</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    } catch (error) {
      console.error('加载 kimi2api 账号列表失败:', error);
    }
  }

  showAddKimi2apiAccountModal() {
    document.getElementById('kimi2apiAccountModalTitle').textContent = '添加账号';
    document.getElementById('kimi2apiAccountId').value = '';
    document.getElementById('kimi2apiAccountName').value = '';
    document.getElementById('kimi2apiAccountToken').value = '';
    document.getElementById('kimi2apiAccountDesc').value = '';
    document.getElementById('kimi2apiAccountPriority').value = '1';
    document.getElementById('kimi2apiAccountEnabled').value = 'true';
    document.getElementById('kimi2apiAccountModal').style.display = 'flex';
    document.getElementById('kimi2apiAccountModal').classList.add('active');
  }

