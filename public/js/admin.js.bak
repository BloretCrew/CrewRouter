      name: document.getElementById('kimi2apiAccountName').value.trim(),
      token: document.getElementById('kimi2apiAccountToken').value.trim(),
      description: document.getElementById('kimi2apiAccountDesc').value.trim(),
      priority: parseInt(document.getElementById('kimi2apiAccountPriority').value) || 1,
      enabled: document.getElementById('kimi2apiAccountEnabled').value === 'true'
    };
    try {
      const url = id ? `/api/admin/kimi2api-accounts/${id}` : '/api/admin/kimi2api-accounts';
