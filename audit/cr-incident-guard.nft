table inet cr_incident_guard {
  chain input {
    type filter hook input priority -10; policy accept;

    # The incident report lists all five other tailnet peers as compromised.
    # Drop both address families before accepting traffic from tailscale0, except
    # for replies to locally initiated PostgreSQL connections from bloret-core.
    iifname "tailscale0" ip saddr 100.64.0.2 tcp sport 5432 ct state established,related counter accept
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::5b36:2806 tcp sport 5432 ct state established,related counter accept
    iifname "tailscale0" ip saddr 100.64.0.2 counter drop
    iifname "tailscale0" ip saddr 100.64.0.3 counter drop
    iifname "tailscale0" ip saddr 100.64.0.4 counter drop
    iifname "tailscale0" ip saddr 100.64.0.5 counter drop
    iifname "tailscale0" ip saddr 100.64.0.7 counter drop
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::5b36:2806 counter drop
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::b029:4d30 counter drop
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::d33a:f121 counter drop
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::2f36:ab64 counter drop
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::b729:471a counter drop

    # Allow sensitive services only from the currently verified management peer.
    iifname "tailscale0" ip saddr 100.109.60.58 tcp dport { 22, 111, 5901, 6080, 9090, 40020, 20003, 28888 } counter accept
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::4329:3c3b tcp dport { 22, 111, 5901, 6080, 9090, 40020, 20003, 28888 } counter accept
    iifname "tailscale0" ip saddr 100.109.60.58 udp dport 111 counter accept
    iifname "tailscale0" ip6 saddr fd7a:115c:a1e0::4329:3c3b udp dport 111 counter accept
    iifname "tailscale0" tcp dport { 22, 111, 5901, 6080, 9090, 40020, 20003, 28888 } counter drop
    iifname "tailscale0" udp dport 111 counter drop

    # Block direct non-tailnet access to management services and the old API.
    iifname != "lo" iifname != "tailscale0" tcp dport { 22, 111, 5901, 6080, 9090, 40020 } counter drop
    iifname != "lo" iifname != "tailscale0" udp dport 111 counter drop
    iifname != "lo" iifname != "tailscale0" tcp dport { 20003, 28888 } counter drop
  }
}
