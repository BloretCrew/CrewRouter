[Unit]
Description=CrewRouter incident network containment rules
Wants=network-pre.target
Before=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nft -f /etc/nftables/cr-incident-guard.nft
ExecReload=/usr/bin/nft -f /etc/nftables/cr-incident-guard.nft
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
