 /* Page composition only. Component chrome and tokens come from the vendored Blora package. */
 @layer legacy, blora;
 @layer legacy {
-:root { font-family: var(--blora-font-sans); background: var(--blora-color-surface-canvas); color: var(--blora-color-text-primary); }
 * { box-sizing: border-box; }
 [hidden] { display: none !important; }
-button, input { font: inherit; }
 button, a { -webkit-tap-highlight-color: transparent; }
-body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--blora-color-surface-canvas); color: var(--blora-color-text-primary); background-image: var(--blora-texture-background); }
+body { margin: 0; min-width: 320px; min-height: 100vh; }
 }
 .launcher { display: flex; flex-direction: column; width: min(calc(100% - (2 * var(--blora-space-6))), 860px); min-height: 100vh; margin: 0 auto; padding: var(--blora-space-5) 0 var(--blora-space-4); }
 .launcher__header, .launcher__footer, .launcher__panel-head, .launcher__block-head { display: flex; align-items: center; justify-content: space-between; gap: var(--blora-space-4); }
 .launcher__header { min-height: 2.75rem; }
 .launcher__header-tools { display: inline-flex; align-items: center; gap: var(--blora-space-3); }
-.desktop-brand { display: inline-flex; align-items: center; gap: var(--blora-space-3); color: var(--blora-color-text-primary); text-decoration: none; }
-.desktop-brand strong { display: block; font-size: var(--blora-text-sm); letter-spacing: 0; }
-.desktop-brand small { display: block; margin-top: 2px; color: var(--blora-color-text-muted); font: 500 var(--blora-text-xs) var(--blora-font-mono); letter-spacing: var(--blora-tracking-caps); }
-.desktop-brand-mark { display: flex; align-items: end; gap: 3px; width: 28px; height: 28px; padding: 5px; border: var(--blora-border-subtle); border-radius: var(--blora-radius-md); background: var(--blora-color-surface-raised); }
-.desktop-brand-mark span { display: block; width: 4px; border-radius: var(--blora-radius-xs); background: var(--blora-color-action-primary-default); }
-.desktop-brand-mark span:nth-child(1) { height: 8px; } .desktop-brand-mark span:nth-child(2) { height: 13px; } .desktop-brand-mark span:nth-child(3) { height: 17px; }
-[data-icon] { display: inline-flex; flex: none; }
-[data-icon] svg { width: 1em; height: 1em; }
+.desktop-brand { display: inline-flex; align-items: center; gap: var(--blora-space-3); text-decoration: none; }
+.desktop-brand strong { display: block; }
+.desktop-brand small { display: block; margin-top: 2px; }
+.launcher [data-icon] { display: inline-flex; flex: none; }
+.launcher [data-icon] svg { width: 1em; height: 1em; }
 .button-icon { display: inline-flex; align-items: center; }
-.desktop-eyebrow { margin: 0 0 var(--blora-space-2); color: var(--blora-color-action-primary-default); font: 600 var(--blora-text-xs) var(--blora-font-mono); letter-spacing: var(--blora-tracking-caps); text-transform: uppercase; }
+.desktop-eyebrow { margin: 0 0 var(--blora-space-2); }
 .launcher__inline-alert { display: block; margin-top: var(--blora-space-4); }
 .launcher__view { display: flex; flex-direction: column; gap: var(--blora-space-6); margin-top: var(--blora-space-6); }
-.launcher__hero h1 { max-width: 36rem; margin: 0; overflow-wrap: anywhere; font-family: var(--blora-font-heading); font-size: clamp(var(--blora-text-3xl), 4.5vw, var(--blora-text-5xl)); line-height: var(--blora-leading-tight); letter-spacing: 0; }
-.launcher__lead { max-width: 44rem; margin: var(--blora-space-3) 0 0; color: var(--blora-color-text-muted); font-size: var(--blora-text-base); line-height: var(--blora-leading-normal); }
+.launcher__hero h1 { max-width: 36rem; margin: 0; overflow-wrap: anywhere; }
+.launcher__lead { max-width: 44rem; margin: var(--blora-space-3) 0 0; }
 .launcher__block { display: grid; gap: var(--blora-space-3); }
-.launcher__block-head h2, .launcher__panel-head h2 { margin: 0; font-family: var(--blora-font-heading); font-size: var(--blora-text-xl); font-weight: 600; line-height: var(--blora-leading-tight); letter-spacing: 0; }
-.launcher__profiles { padding: 0; overflow: hidden; }
-.launcher__profile { gap: var(--blora-space-4); padding: var(--blora-space-4) var(--blora-space-5); }
-.launcher__profile-icon { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: var(--blora-radius-md); color: var(--blora-color-action-primary-default); background: var(--blora-color-surface-raised); }
+.launcher__block-head h2, .launcher__panel-head h2 { margin: 0; }
