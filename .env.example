# ============================================
# CrewRouter 环境变量配置模板
#
# 使用方法：复制此文件为 .env，然后填写实际值
#   cp .env.example .env
# ============================================

# --- 应用配置 ---
CR_APP_PORT=20003
CR_APP_HOST=localhost
CR_SESSION_SECRET=请替换为一个随机字符串

# --- 数据库 ---
CR_DB_HOST=postgres
CR_DB_PORT=5432
CR_DB_NAME=crewrouter
CR_DB_USER=crewrouter
CR_DB_PASSWORD=请替换为强密码

# --- 邮件（可选，用于注册验证等） ---
CR_EMAIL_ADDRESS=
CR_EMAIL_PASSWORD=
CR_SMTP_HOST=
CR_SMTP_PORT=465
CR_SMTP_SSL=true

# --- 飞书集成（可选） ---
CR_FEISHU_APP_ID=
CR_FEISHU_APP_SECRET=
CR_FEISHU_TENANT_KEY=

# --- GitHub OAuth（可选） ---
CR_GITHUB_CLIENT_ID=
CR_GITHUB_CLIENT_SECRET=
CR_GITHUB_REDIRECT_URI=
