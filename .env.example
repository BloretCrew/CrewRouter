# ============================================
# CrewRouter 环境变量配置模板
#
# 使用方法：复制此文件为 .env，然后填写实际值
#   cp .env.example .env
# ============================================

# --- 应用配置 ---
CR_APP_PORT=20003
CR_APP_HOST=localhost
CR_SESSION_SECRET=请替换为一个随机字符串
# 数据库中的供应商密钥刷新脚本默认禁用；逐个审阅脚本与目标后才设置为 1
CR_ENABLE_KEY_SCRIPTS=0
# 自定义额度配置可能向请求地址发送供应商 API Key，默认禁用；审阅配置与目标后才设置为 1
CR_ENABLE_CUSTOM_QUOTA_SCRIPTS=0
# 反向代理来源（默认 loopback）；如使用远程代理，填写可信代理 IP/CIDR，避免只配置跳数却仍允许公网直连。
CR_TRUST_PROXY=loopback

# --- 数据库 ---
CR_DB_HOST=postgres
CR_DB_PORT=5432
CR_DB_NAME=crewrouter
CR_DB_USER=crewrouter
CR_DB_PASSWORD=请替换为强密码

# --- 邮件（可选，用于注册验证等） ---
CR_EMAIL_ADDRESS=
CR_EMAIL_PASSWORD=
CR_SMTP_HOST=
CR_SMTP_PORT=465
CR_SMTP_SSL=true

# --- 飞书集成（可选） ---
CR_FEISHU_APP_ID=
CR_FEISHU_APP_SECRET=
CR_FEISHU_TENANT_KEY=

# --- GitHub OAuth（可选） ---
CR_GITHUB_CLIENT_ID=
CR_GITHUB_CLIENT_SECRET=
CR_GITHUB_REDIRECT_URI=
