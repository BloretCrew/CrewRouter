{
  "name": "crewrouter-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CrewRouter Desktop application",
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dev": "NODE_ENV=development electron .",
    "prepare:renderer": "node scripts/prepare-blora-assets.js",
    "syntax": "node scripts/check-syntax.js",
    "test:local-server": "node scripts/test-local-server.js",
    "test:packaged-server": "node scripts/test-local-server.js --packaged",
    "test:electron:local-username": "node scripts/run-electron-acceptance.js",
    "test:electron:real-pages": "node scripts/run-real-page-acceptance.js",
    "validate:server-bundle": "node scripts/validate-server-bundle.js",
    "stage:server": "node scripts/stage-server.js",
    "pack": "npm run stage:server && npm run validate:server-bundle && electron-builder --publish never",
    "pack:linux": "npm run stage:server && npm run validate:server-bundle && electron-builder --linux AppImage --publish never",
    "pack:win": "npm run stage:server && npm run validate:server-bundle && electron-builder --win nsis --publish never",
    "pack:mac": "npm run stage:server && npm run validate:server-bundle && electron-builder --mac dmg --publish never",
    "build": "npm run stage:server && npm run validate:server-bundle && electron-builder --linux AppImage --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.crewrouter.desktop",
    "productName": "CrewRouter Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "icon": "build/icons/crewrouter.png",
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "README.md",
      "node_modules/@bloret-crew/blora-design/**/*",
      "node_modules/embedded-postgres/**/*",
      "node_modules/@embedded-postgres/**/*"
    ],
    "asarUnpack": [
      "node_modules/embedded-postgres/**/*",
      "node_modules/@embedded-postgres/**/*"
    ],
    "extraResources": [
      {
        "from": "staging/server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "icon": "build/icons/crewrouter.png",
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "protocols": [
      {
        "name": "CrewRouter Desktop Link",
        "schemes": [
          "crewrouter"
        ]
      }
    ],
    "win": {
      "icon": "build/icons/crewrouter.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icons/crewrouter.png",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "crewrouter"
            ]
          }
        ]
      }
    }
  },
  "dependencies": {
    "@bloret-crew/blora-design": "2.1.0"
  }
}
