{
  "name": "crewrouter",
  "version": "27.0.0-beta.1",
  "description": "CrewRouter - AI API 网关平台",
  "productVersion": "27.0",
  "releaseChannel": "beta",
  "main": "server/index.js",
  "bin": {
    "cr": "cli/bin/cr.js",
    "crewrouter": "cli/bin/cr.js"
  },
  "exports": {
    ".": "./server/index.js",
    "./embedded": "./server/sdk/embedded.js",
    "./package.json": "./package.json"
  },
  "files": [
    "server/**/*.js",
    "public/**",
    "lang/**",
    "plugins/**",
    "cli/bin/**",
    "cli/lib/**",
    "cli/tui/**",
    "cli/index.js",
    "config.example.json",
    "LICENSE",
    "README.md",
    "docs/cli.md",
    "docs/sdk/**",
    "docs/github-actions-oidc.md",
    "docs/plugin-security.md"
  ],
  "scripts": {
    "test:plugins": "node server/scripts/test-plugin-capabilities.js && node server/scripts/test-plugin-route-auth.js && node server/scripts/test-plugin-pref-optin-transactions.js && node server/scripts/test-plugin-build-artifacts.js && node server/scripts/test-plugin-task-queue.js && node server/scripts/test-plugin-events.js && node server/scripts/test-plugin-manifest-schema.js && node server/scripts/test-plugin-signatures.js && node server/scripts/test-plugin-store-signatures.js && node server/scripts/test-plugin-package-info.js && node server/scripts/test-plugin-quota-events.js",
    "test:signatures": "node --test server/scripts/test-signature-*.js server/scripts/test-user-signature-settings.js server/scripts/test-default-disabled.js",
    "test:signatures:browser": "node scripts/test-settings-defaults-browser.js --signature-only",
    "test:usage-write": "node --test server/scripts/test-token-normalize.js server/scripts/test-usage-write-guards.js",
    "test:usage-repair": "node --test server/scripts/test-usage-timestamp-repair.js",
    "test:model-trace": "node server/scripts/test-lm-detector.js && node server/scripts/test-model-trace-ui-contract.js && node server/scripts/test-model-trace-transport.js && node server/scripts/test-model-trace-quota.js && node server/scripts/test-model-trace-runner-recovery.js && node scripts/test-model-trace-package.js",
    "test:upstream-generation": "node server/scripts/test-upstream-generation-routes.js && node --test server/scripts/test-upstream-transport.js && node server/scripts/test-upstream-stream-safety.js",
    "test:provider-endpoints": "node server/scripts/test-provider-endpoints.js && node server/scripts/test-provider-endpoints-routes.js && node server/scripts/test-provider-endpoint-sync-fingerprint.js",
    "test:key-config": "node server/scripts/test-api-key-lifecycle.js && node server/scripts/test-inject-prompt-cache-lifecycle.js && node --test server/scripts/test-inject-prompt-transactions.js && node server/scripts/test-inject-prompt-seed-postgres.js && node server/scripts/test-api-key-queue-concurrency.js",
    "test:passkey-security": "node --test server/scripts/test-passkey-security.js && node server/scripts/test-passkey-store-postgres.js",
    "test:oauth-bearer-policy": "node --test server/scripts/test-oauth-bearer-policy.js",
    "test:oauth-clients": "node --test server/scripts/test-oauth-clients.js",
    "test:oauth-clients-postgres": "node server/scripts/test-oauth-clients-postgres.js",
    "test:api-key-permissions": "node --test server/scripts/test-api-key-permissions.js server/scripts/test-console-key-auth.js && node server/scripts/test-console-route-auth-coverage.js",
    "test:csrf-boundaries": "node server/scripts/test-csrf-boundaries.js",
    "test:security-audit": "node --test server/scripts/test-security-audit.js && node server/scripts/test-security-audit-postgres.js",
    "test:security-guards": "node --test server/scripts/test-auth-guards.js server/scripts/test-incident-guard.js && node server/scripts/test-provider-manager-permissions.js && node server/scripts/test-batch-e-permissions.js",
    "test:public-schema-create": "node --test server/scripts/test-public-schema-create-postgres.js",
    "test:responses-compat": "node server/scripts/test-responses-compat.js",
    "start": "node server/index.js",
    "cli": "node cli/bin/cr.js",
    "test:cli": "node --test cli/test/*.test.js",
    "dev": "nodemon server/index.js",
    "init-db": "node server/scripts/init-db.js",
    "test:sessions-pagination": "node server/scripts/test-sessions-pagination.js",
    "test:session-identity": "node server/scripts/test-session-identity.js",
    "test:session-classification": "node server/scripts/test-session-classification-static.js",
    "test:usage-accuracy": "node server/scripts/test-usage-accuracy.js",
    "test:model-identity": "node --test server/scripts/test-model-identity.js && node server/scripts/test-model-identity-data.js && node scripts/test-model-identity-ui.js",
    "test:model-identity:browser": "node scripts/test-model-identity-browser.js",
    "test:session-summary-model-selection": "node server/scripts/test-session-summary-model-selection.js",
    "test:before-upstream-policy": "node server/scripts/test-before-upstream-policy.js",
    "test:quota-usage": "node server/scripts/test-quota-usage.js && node server/scripts/test-cpa-usage.js && node server/scripts/test-balance-provider-usage.js",
    "test:reliability-closure": "node server/scripts/test-reliability-closure-static.js",
    "audit:team-consistency": "node server/scripts/audit-team-consistency.js --dry-run",
    "test:fusion-synthesis-prompt": "node server/scripts/test-fusion-synthesis-prompt.js",
    "test:frontier-auto-add": "node server/scripts/test-frontier-auto-add.js",
    "build": "node deploy/build/build-release.js release",
    "build:saas": "node deploy/build/build-release.js saas",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t crewrouter/crewrouter:latest .",
    "docker:build:saas": "docker build -f deploy/docker/Dockerfile.saas -t crewrouter/crewrouter-saas:latest .",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:up:saas": "docker-compose -f docker-compose.saas.yml up -d",
    "test:money-precision": "node server/scripts/test-money-precision.js",
    "test:task5a-static": "node server/scripts/test-task5a-static.js",
    "test:request-policy": "node server/scripts/test-request-policy.js",
    "test:policies": "node server/scripts/test-policy-engine.js && node server/scripts/test-policy-validation.js && node server/scripts/test-policy-lifecycle.js && node server/scripts/test-policy-routes-static.js && node server/scripts/test-time-format.js",
    "test:time-format": "node server/scripts/test-time-format.js",
    "test:config-center": "node server/scripts/test-config-center.js",
    "test:instance-edition": "node server/scripts/test-instance-edition.js && node server/scripts/test-instance-edition-persistence.js",
    "test:edition-badge": "node server/scripts/test-edition-badge.js",
    "test:batch-e-permissions": "node server/scripts/test-batch-e-permissions.js",
    "test:email-toctou-static": "node server/scripts/test-email-toctou-static.js",
    "test:outbox": "node server/scripts/test-outbox.js",
    "audit:blora-pages": "node scripts/audit-blora-pages.js --write",
    "test:blora-foundation": "node scripts/test-blora-foundation.js && node scripts/test-blora-audit-parser.js && node scripts/test-blora-http.js",
    "test:blora-public-batch-a": "node scripts/verify-blora-public-batch-a.js",
    "test:blora-public-batch-c": "node scripts/test-blora-public-batch-c.js",
    "test:blora-navbar-runtime": "node scripts/verify-blora-navbar-runtime.js",
    "test:blora-runtime": "cd CrewRouter-Desktop && xvfb-run -a node_modules/.bin/electron --disable-gpu --no-sandbox ../scripts/verify-blora-runtime.js",
    "test:no-legacy-dialog": "node scripts/test-no-legacy-dialog.js",
    "test:popup-notices": "node --test server/scripts/test-popup-notices.js server/scripts/test-popup-notice-routes.js",
    "test:library-closed-keys": "node scripts/test-library-closed-keys.js",
    "test:library-closed-keys:browser": "node scripts/test-library-closed-keys-browser.js",
    "test:api-key-search:browser": "node scripts/test-api-key-search-browser.js",
    "money-precision:migrate": "node scripts/migrate-money-precision.js",
    "sdk:generate": "node sdk/codegen/generate.mjs",
    "sdk:check": "node sdk/codegen/generate.mjs --check",
    "sdk:conformance": "node sdk/conformance/run.mjs --all",
    "test:embedded-sdk": "node --test server/scripts/test-embedded-sdk.js server/scripts/test-embedded-sdk-options.js server/scripts/test-embedded-sdk-features.js server/scripts/test-embedded-sdk-console.js",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test:protocol": "node --test server/protocol/test/*.test.js",
    "test:gemini": "node server/scripts/test-gemini-bridge-routes.js",
    "test:agent-multiplier": "node server/scripts/test-agent-multiplier.js",
    "test:agent-attachments": "node server/scripts/test-agent-attachments.js",
    "test:agent-fetch": "node server/scripts/test-agent-fetch.js",
    "test:agent-web-search": "node server/scripts/test-agent-web-search.js",
    "test:blora-agent-pricing-ui": "node scripts/test-blora-agent-pricing-ui.js",
    "test:blora-agent-pricing-browser": "node scripts/test-blora-agent-pricing-browser.js",
    "test:agent-e2e": "node server/scripts/test-agent-e2e.js"
  },
  "dependencies": {
    "@bloret-crew/blora-design": "2.1.0",
    "@simplewebauthn/server": "^13.3.3",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-session": "^1.17.3",
    "formidable": "^3.5.4",
    "http-proxy-middleware": "^3.0.5",
    "https-proxy-agent": "^9.0.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.1.6",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^10.1.0",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
