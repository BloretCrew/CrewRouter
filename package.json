{
  "name": "crewrouter",
  "version": "1.0.0",
  "description": "CrewRouter - AI API 网关平台",
  "main": "server/index.js",
  "scripts": {
    "test:model-trace": "node server/scripts/test-lm-detector.js && node server/scripts/test-model-trace-ui-contract.js && node server/scripts/test-model-trace-transport.js && node server/scripts/test-model-trace-quota.js && node server/scripts/test-model-trace-runner-recovery.js && node scripts/test-model-trace-package.js",
    "test:upstream-generation": "node server/scripts/test-upstream-generation-routes.js && node --test server/scripts/test-upstream-transport.js && node server/scripts/test-upstream-stream-safety.js",
    "test:key-config": "node server/scripts/test-api-key-lifecycle.js && node server/scripts/test-inject-prompt-cache-lifecycle.js && node --test server/scripts/test-inject-prompt-transactions.js && node server/scripts/test-inject-prompt-seed-postgres.js && node server/scripts/test-api-key-queue-concurrency.js",
    "test:security-audit": "node --test server/scripts/test-security-audit.js && node server/scripts/test-security-audit-postgres.js",
    "test:responses-compat": "node server/scripts/test-responses-compat.js",
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "init-db": "node server/scripts/init-db.js",
    "test:sessions-pagination": "node server/scripts/test-sessions-pagination.js",
    "test:session-identity": "node server/scripts/test-session-identity.js",
    "test:session-classification": "node server/scripts/test-session-classification-static.js",
    "test:usage-accuracy": "node server/scripts/test-usage-accuracy.js",
    "test:model-identity": "node --test server/scripts/test-model-identity.js && node server/scripts/test-model-identity-data.js && node scripts/test-model-identity-ui.js",
    "test:model-identity:browser": "node scripts/test-model-identity-browser.js",
    "test:session-summary-model-selection": "node server/scripts/test-session-summary-model-selection.js",
    "test:before-upstream-policy": "node server/scripts/test-before-upstream-policy.js",
    "test:quota-usage": "node server/scripts/test-quota-usage.js && node server/scripts/test-cpa-usage.js && node server/scripts/test-balance-provider-usage.js",
    "test:reliability-closure": "node server/scripts/test-reliability-closure-static.js",
    "audit:team-consistency": "node server/scripts/audit-team-consistency.js --dry-run",
    "test:fusion-synthesis-prompt": "node server/scripts/test-fusion-synthesis-prompt.js",
    "test:frontier-auto-add": "node server/scripts/test-frontier-auto-add.js",
    "build": "node deploy/build/build-release.js release",
    "build:saas": "node deploy/build/build-release.js saas",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t crewrouter/crewrouter:latest .",
    "docker:build:saas": "docker build -f deploy/docker/Dockerfile.saas -t crewrouter/crewrouter-saas:latest .",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:up:saas": "docker-compose -f docker-compose.saas.yml up -d",
    "test:money-precision": "node server/scripts/test-money-precision.js",
    "test:task5a-static": "node server/scripts/test-task5a-static.js",
    "test:request-policy": "node server/scripts/test-request-policy.js",
    "test:config-center": "node server/scripts/test-config-center.js",
    "test:instance-edition": "node server/scripts/test-instance-edition.js && node server/scripts/test-instance-edition-persistence.js",
    "test:edition-badge": "node server/scripts/test-edition-badge.js",
    "test:batch-e-permissions": "node server/scripts/test-batch-e-permissions.js",
    "test:email-toctou-static": "node server/scripts/test-email-toctou-static.js",
    "test:outbox": "node server/scripts/test-outbox.js",
    "audit:blora-pages": "node scripts/audit-blora-pages.js --write",
    "test:blora-foundation": "node scripts/test-blora-foundation.js && node scripts/test-blora-audit-parser.js && node scripts/test-blora-http.js",
    "test:blora-public-batch-a": "node scripts/verify-blora-public-batch-a.js",
    "test:blora-public-batch-c": "node scripts/test-blora-public-batch-c.js",
    "test:blora-navbar-runtime": "node scripts/verify-blora-navbar-runtime.js",
    "test:blora-runtime": "cd CrewRouter-Desktop && xvfb-run -a node_modules/.bin/electron --disable-gpu --no-sandbox ../scripts/verify-blora-runtime.js",
    "test:no-legacy-dialog": "node scripts/test-no-legacy-dialog.js",
    "test:library-closed-keys": "node scripts/test-library-closed-keys.js",
    "test:library-closed-keys:browser": "node scripts/test-library-closed-keys-browser.js",
    "money-precision:migrate": "node scripts/migrate-money-precision.js"
  },
  "dependencies": {
    "@bloret-crew/blora-design": "2.1.0",
    "@simplewebauthn/server": "^13.3.3",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-session": "^1.17.3",
    "formidable": "^3.5.4",
    "http-proxy-middleware": "^3.0.5",
    "https-proxy-agent": "^9.0.0",
    "nodemailer": "^10.1.6",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^10.1.0",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
